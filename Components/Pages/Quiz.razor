@code {
    [SupplyParameterFromQuery]
    public string? Category { get; set; }

    // ── State ──────────────────────────────────────────────
    private List<QuizQuestion> questions = [];
    private Dictionary<string, int> availableCategories = [];
    private Dictionary<string, double> bestScoresPerCategory = [];
    private string activeSectionFilter = "All";

    private IEnumerable<KeyValuePair<string, int>> DisplayedCategories =>
        activeSectionFilter == "All"
            ? availableCategories
            : availableCategories.Where(c => QuizCategorySections.GetSection(c.Key) == activeSectionFilter);

    private int currentQuestionIndex;
    private bool isAnswered;
    private bool isQuizCompleted;
    private bool isLoading = true;
    public enum QuizMode
    {
        Timed,
        Practice,
        ExamSimulation
    }

    private QuizMode quizMode = QuizMode.Timed;
    private bool practiceMode => quizMode == QuizMode.Practice;
    private bool isExamMode => quizMode == QuizMode.ExamSimulation;
    private HashSet<int> flaggedQuestionIds = [];
    private bool showSubmitConfirm;

    private int AnsweredCount => userAnswers.Count(a => a.SelectedOptionId != -1);
    private int MissedQuestionsCount => quizResult != null ? (quizResult.TotalQuestions - quizResult.CorrectAnswers) : 0;
    private bool IsNationalExamCategory => Category != null && (Category == "BECE" || Category == "WASSCE" || Category == "TEACHERS PROMOTION" || Category == "NTC Licensure Exams");

    private void SetMode(QuizMode mode) => quizMode = mode;
    private void ToggleFlag(int questionId)
    {
        if (!flaggedQuestionIds.Add(questionId))
            flaggedQuestionIds.Remove(questionId);
    }

    private bool isPaused;
    private bool showReview = true;
    private string loadingMessage = "Loading...";

    private int currentScore;
    private int streak;
    private int bestStreak;
    private int lastSpeedBonus;

    private int currentQuestionDuration;
    private DateTime questionStartTime;

    private QuizResult? quizResult;
    private List<QuizAnswer> userAnswers = [];
    private DateTime quizStartTime = DateTime.UtcNow;
    private string currentUserId = string.Empty;
    private string currentUserName = string.Empty;
    private bool canTakeQuiz = true;
    private int monthlyCount;
    private int monthlyLimit = 5;

    private QuizTimer? quizTimer;
    private ElementReference quizContainer;
    private IDisposable? _navHandler;

    private QuizQuestion? currentQuestion =>
        questions.Count > 0 && currentQuestionIndex < questions.Count
            ? questions[currentQuestionIndex] : null;

    private bool isCurrentAnswerCorrect =>
        currentQuestion != null &&
        userAnswers.Any(a => a.QuestionId == currentQuestion.Id &&
                             a.SelectedOptionId == currentQuestion.CorrectOptionId);

    // ── Lifecycle ──────────────────────────────────────────
    protected override async Task OnInitializedAsync() => await LoadPageAsync();

    protected override async Task OnParametersSetAsync()
    {
        if (!isLoading) await LoadPageAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            _navHandler = NavigationManager.RegisterLocationChangingHandler(OnLocationChanging);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Auto-focus the quiz container so keyboard shortcuts work
        if (!isLoading && !string.IsNullOrEmpty(Category) && questions.Any() && !isQuizCompleted)
        {
            try { await JS.InvokeVoidAsync("focusElement", quizContainer); } catch { }
        }
    }

    private async ValueTask OnLocationChanging(LocationChangingContext ctx)
    {
        if (!isQuizCompleted && questions.Any() && !string.IsNullOrEmpty(Category))
        {
            var ok = await JS.InvokeAsync<bool>("confirm",
                "You have an active quiz. Leave and lose progress?");
            if (!ok) ctx.PreventNavigation();
        }
    }

    public void Dispose()
    {
        _navHandler?.Dispose();
        quizTimer?.Dispose();
    }

    // ── Load ───────────────────────────────────────────────
    private async Task LoadPageAsync()
    {
        try
        {
            isLoading = true;
            loadingMessage = "Loading...";

            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                currentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
                currentUserName = authState.User.FindFirst(ClaimTypes.Email)?.Value ?? "Anonymous";
            }

            if (!string.IsNullOrEmpty(currentUserId))
            {
                canTakeQuiz = await SubscriptionService.CanTakeQuizAsync(currentUserId);
                monthlyCount = await SubscriptionService.GetMonthlyQuizCountAsync(currentUserId);
                var tier = await SubscriptionService.GetUserTierAsync(currentUserId);
                monthlyLimit = tier.GetMonthlyQuizLimit();

                if (!canTakeQuiz) return;
            }

            var all = await QuizBusinessService.GetQuestionsAsync();

            if (string.IsNullOrEmpty(Category))
            {
                availableCategories = all
                    .GroupBy(q => q.Category)
                    .OrderBy(g => g.Key)
                    .ToDictionary(g => g.Key, g => g.Count());

                if (!string.IsNullOrEmpty(currentUserId))
                    bestScoresPerCategory = await QuizBusinessService.GetBestScoresPerCategoryAsync(currentUserId);

                questions = [];
            }
            else
            {
                loadingMessage = $"Loading {Category} questions...";
                var filtered = all
                    .Where(q => q.Category.Equals(Category, StringComparison.OrdinalIgnoreCase))
                    .ToList();

                var max = AppSettings.Value.Quiz.MaxQuestionsPerQuiz;
                if (AppSettings.Value.Quiz.RandomizeQuestions && filtered.Count > 0)
                {
                    var rng = new Random();
                    filtered = filtered.OrderBy(_ => rng.Next()).ToList();
                }

                questions = filtered.Take(max).ToList();
                ResetQuizState();
            }
        }
        catch (Exception)
        {
            NotificationService.ShowError("Failed to load quiz. Please try again.");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ResetQuizState()
    {
        currentQuestionIndex = 0;
        isAnswered = false;
        isQuizCompleted = false;
        isPaused = false;
        showReview = true;
        showSubmitConfirm = false;
        flaggedQuestionIds.Clear();
        userAnswers = [];
        quizResult = null;
        currentScore = 0;
        streak = 0;
        bestStreak = 0;
        lastSpeedBonus = 0;
        quizStartTime = DateTime.UtcNow;
        SetCurrentQuestionTimer();
    }

    private void SetCurrentQuestionTimer()
    {
        if (currentQuestion == null) return;
        currentQuestionDuration = practiceMode ? 0
            : AppSettings.Value.Quiz.GetSecondsForDifficulty(currentQuestion.Difficulty);
        questionStartTime = DateTime.UtcNow;
    }

    // ── Navigation ─────────────────────────────────────────
    private void StartQuiz(string category)
        => NavigationManager.NavigateTo($"/quiz?category={Uri.EscapeDataString(category)}");

    private void BackToTopics()
        => NavigationManager.NavigateTo("/quiz");

    private async Task ConfirmBackToTopics()
    {
        if (userAnswers.Count > 0 && !isQuizCompleted)
        {
            var ok = await JS.InvokeAsync<bool>("confirm", "Leave quiz and lose progress?");
            if (!ok) return;
        }
        BackToTopics();
    }

    // ── Quiz logic ─────────────────────────────────────────
    private void SelectOption(QuizOption option)
    {
        if (currentQuestion == null || isPaused) return;

        if (isExamMode)
        {
            var existingAnswer = userAnswers.FirstOrDefault(a => a.QuestionId == currentQuestion.Id);
            if (existingAnswer != null)
            {
                existingAnswer.SelectedOptionId = option.Id;
                existingAnswer.AnsweredAt = DateTime.UtcNow;
            }
            else
            {
                userAnswers.Add(new QuizAnswer
                {
                    QuestionId = currentQuestion.Id,
                    SelectedOptionId = option.Id,
                    AnsweredAt = DateTime.UtcNow,
                    TimeTakenSeconds = (int)(DateTime.UtcNow - questionStartTime).TotalSeconds
                });
            }
            StateHasChanged();
            return;
        }

        if (isAnswered) return;

        var timeTaken = (int)(DateTime.UtcNow - questionStartTime).TotalSeconds;

        var existing = userAnswers.FirstOrDefault(a => a.QuestionId == currentQuestion.Id);
        if (existing != null)
        {
            existing.SelectedOptionId = option.Id;
            existing.TimeTakenSeconds = timeTaken;
        }
        else
        {
            userAnswers.Add(new QuizAnswer
            {
                QuestionId = currentQuestion.Id,
                SelectedOptionId = option.Id,
                AnsweredAt = DateTime.UtcNow,
                TimeTakenSeconds = timeTaken
            });
        }

        isAnswered = true;
        quizTimer?.StopTimer();

        // Points + streak
        if (option.Id == currentQuestion.CorrectOptionId)
        {
            streak++;
            if (streak > bestStreak) bestStreak = streak;

            if (!practiceMode)
            {
                var pts = AppSettings.Value.Quiz.GetPointsForDifficulty(currentQuestion.Difficulty);
                lastSpeedBonus = 0;
                if (timeTaken < currentQuestionDuration * 0.5)
                {
                    lastSpeedBonus = AppSettings.Value.Quiz.SpeedBonusPoints;
                    pts += lastSpeedBonus;
                }
                currentScore += pts;
            }
        }
        else
        {
            streak = 0;
            lastSpeedBonus = 0;
        }

        StateHasChanged();
    }

    private async Task NextQuestion()
    {
        if (currentQuestionIndex < questions.Count - 1)
        {
            currentQuestionIndex++;
            isAnswered = !isExamMode && userAnswers.Any(a => a.QuestionId == questions[currentQuestionIndex].Id);
            SetCurrentQuestionTimer();
            StateHasChanged();
        }
        else if (isExamMode)
        {
            showSubmitConfirm = true;
        }
        else
        {
            await CompleteQuiz();
        }
    }

    private void PreviousQuestion()
    {
        if (currentQuestionIndex > 0)
        {
            currentQuestionIndex--;
            isAnswered = !isExamMode && userAnswers.Any(a => a.QuestionId == questions[currentQuestionIndex].Id);
            SetCurrentQuestionTimer();
            StateHasChanged();
        }
    }

    private void NavigateToQuestion(int index)
    {
        if (index < 0 || index >= questions.Count) return;
        currentQuestionIndex = index;
        isAnswered = !isExamMode && userAnswers.Any(a => a.QuestionId == questions[index].Id);
        SetCurrentQuestionTimer();
        StateHasChanged();
    }

    private void TogglePause()
    {
        isPaused = !isPaused;
        if (isPaused) quizTimer?.StopTimer();
        else          quizTimer?.ResetTimer();
        StateHasChanged();
    }

    private async Task ConfirmAndSubmitExam()
    {
        showSubmitConfirm = false;
        await CompleteQuiz();
    }

    private void PracticeMissedQuestions()
    {
        var missedQuestionIds = userAnswers
            .Where(a =>
            {
                var q = questions.FirstOrDefault(x => x.Id == a.QuestionId);
                return q != null && a.SelectedOptionId != q.CorrectOptionId;
            })
            .Select(a => a.QuestionId)
            .ToHashSet();

        if (missedQuestionIds.Count == 0) return;

        questions = questions.Where(q => missedQuestionIds.Contains(q.Id)).ToList();
        quizMode = QuizMode.Practice;
        ResetQuizState();
    }

    private async Task CompleteQuiz()
    {
        try
        {
            // Fill unanswered with -1
            foreach (var q in questions)
            {
                if (!userAnswers.Any(a => a.QuestionId == q.Id))
                    userAnswers.Add(new QuizAnswer { QuestionId = q.Id, SelectedOptionId = -1, AnsweredAt = DateTime.UtcNow });
            }

            if (isExamMode)
            {
                currentScore = 0;
                foreach (var a in userAnswers)
                {
                    var q = questions.FirstOrDefault(x => x.Id == a.QuestionId);
                    if (q != null && a.SelectedOptionId == q.CorrectOptionId)
                    {
                        currentScore += AppSettings.Value.Quiz.GetPointsForDifficulty(q.Difficulty);
                    }
                }
            }

            var duration = DateTime.UtcNow - quizStartTime;

            quizResult = await QuizBusinessService.SubmitQuizAsync(
                userAnswers, currentUserId, duration,
                Category ?? string.Empty, practiceMode, currentScore);

            if (!practiceMode)
                await SubscriptionService.IncrementQuizUsageAsync(currentUserId);

            isQuizCompleted = true;
            StateHasChanged();
            NotificationService.ShowSuccess($"Quiz done! {quizResult.ScorePercentage:F0}%{(!practiceMode ? $" — {currentScore} pts" : "")}");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save quiz result for {UserId}", currentUserId);
            NotificationService.ShowError("Quiz completed but result could not be saved.");

            var correct = userAnswers.Count(a =>
            {
                var q = questions.FirstOrDefault(q => q.Id == a.QuestionId);
                return q != null && a.SelectedOptionId == q.CorrectOptionId;
            });

            quizResult = new QuizResult
            {
                UserId = currentUserId, UserName = currentUserName,
                Category = Category ?? string.Empty,
                TotalQuestions = userAnswers.Count, CorrectAnswers = correct,
                Score = currentScore, IsPracticeMode = practiceMode,
                CompletedAt = DateTime.UtcNow, Duration = DateTime.UtcNow - quizStartTime,
                Answers = userAnswers
            };

            isQuizCompleted = true;
            StateHasChanged();
        }
    }

    private async Task HandleTimeUp()
    {
        if (isAnswered) { await NextQuestion(); return; }
        NotificationService.ShowWarning("Time's up for this question!");
        // Auto-mark as unanswered and move on
        userAnswers.Add(new QuizAnswer { QuestionId = currentQuestion!.Id, SelectedOptionId = -1, AnsweredAt = DateTime.UtcNow });
        streak = 0;
        isAnswered = true;
        StateHasChanged();
        await Task.Delay(1200);
        await NextQuestion();
    }

    private void HandleTimeChanged(int timeRemaining)
    {
        var warnAt = Math.Max(5, (int)(currentQuestionDuration * 0.10));
        if (timeRemaining == warnAt)
            NotificationService.ShowWarning($"Only {timeRemaining}s left for this question!");
    }

    private void RestartQuiz()
    {
        if (AppSettings.Value.Quiz.RandomizeQuestions)
            questions = questions.OrderBy(_ => new Random().Next()).ToList();
        ResetQuizState();
    }

    // ── Keyboard shortcuts ─────────────────────────────────
    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (isPaused) { if (e.Key == "p" || e.Key == "P") TogglePause(); return; }
        if (isQuizCompleted) return;

        switch (e.Key)
        {
            case "1": case "2": case "3": case "4":
            case "5": case "6": case "7": case "8":
                if (!isAnswered && currentQuestion != null)
                {
                    var idx = int.Parse(e.Key) - 1;
                    if (idx < currentQuestion.Options.Count)
                        SelectOption(currentQuestion.Options[idx]);
                }
                break;
            case "Enter": case " ":
                if (isAnswered) await NextQuestion();
                break;
            case "ArrowRight":
                if (isAnswered) await NextQuestion();
                break;
            case "ArrowLeft":
                PreviousQuestion();
                break;
            case "p": case "P":
                if (!practiceMode) TogglePause();
                break;
        }
    }

    // ── Helpers ────────────────────────────────────────────
    private double GetProgressPercentage() =>
        questions.Count > 0 ? (double)(currentQuestionIndex + 1) / questions.Count * 100 : 0;

    private string GetCorrectAnswerText() =>
        currentQuestion?.Options.FirstOrDefault(o => o.Id == currentQuestion.CorrectOptionId)?.Text ?? "Unknown";

    private string GetOptionClass(QuizOption option)
    {
        if (currentQuestion == null) return string.Empty;

        var userChoice = userAnswers.FirstOrDefault(a => a.QuestionId == currentQuestion.Id)?.SelectedOptionId;

        if (isExamMode)
        {
            return userChoice == option.Id ? "selected-exam" : string.Empty;
        }

        if (!isAnswered) return string.Empty;
        if (option.Id == currentQuestion.CorrectOptionId) return "correct";
        if (option.Id == userChoice) return "wrong";
        return "dim";
    }

    private string GetNavButtonClass(int index, bool answered, bool flagged, bool isCurrent)
    {
        if (isCurrent) return "btn-primary border border-2 border-dark fw-bold";
        if (flagged) return "btn-warning text-dark fw-bold";
        if (isExamMode)
        {
            return answered ? "btn-success" : "btn-outline-secondary";
        }

        if (answered)
        {
            var a = userAnswers.FirstOrDefault(a => a.QuestionId == questions[index].Id);
            return a?.SelectedOptionId == questions[index].CorrectOptionId ? "btn-success" : "btn-danger";
        }
        return "btn-outline-secondary";
    }

    private static (string Grade, string Description, string BadgeClass) GetStanineGrade(double percentage) => percentage switch
    {
        >= 75 => ("Grade 1", "Distinction (Excellent)", "bg-success"),
        >= 70 => ("Grade 2", "Distinction (Very Good)", "bg-success"),
        >= 65 => ("Grade 3", "Credit (Good)", "bg-primary"),
        >= 60 => ("Grade 4", "Credit (Satisfactory)", "bg-primary"),
        >= 55 => ("Grade 5", "Credit (Above Average)", "bg-info text-dark"),
        >= 50 => ("Grade 6", "Credit (Average)", "bg-info text-dark"),
        >= 45 => ("Grade 7", "Pass", "bg-warning text-dark"),
        >= 40 => ("Grade 8", "Pass", "bg-warning text-dark"),
        _     => ("Grade 9", "Fail", "bg-danger")
    };

    private static (string Status, string BadgeClass) GetLicensureStatus(double percentage) =>
        percentage >= 50 ? ("LICENSED / PASSED", "bg-success") : ("NOT QUALIFIED / RETAKE NEEDED", "bg-danger");

    private static string GetCategoryIcon(string category) => QuizCategorySections.GetIcon(category);

    private static string GetScoreBadgeClass(double score) =>
        score >= 80 ? "bg-success" : score >= 60 ? "bg-warning text-dark" : "bg-danger";

    private static string GetDifficultyBadgeClass(string difficulty) => difficulty switch
    {
        "Easy" => "bg-success", "Hard" => "bg-danger", _ => "bg-warning text-dark"
    };
}
