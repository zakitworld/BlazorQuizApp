{
  "ConnectionStrings": {
    "DefaultConnection": "#{ConnectionString}#"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Error"
    }
  },
  "AllowedHosts": "*",
  "AppSettings": {
    "AdminUser": {
      "Email": "#{AdminEmail}#"
    },
    "Quiz": {
      "DefaultTimeLimit": 300,
      "MaxQuestionsPerQuiz": 10,
      "RandomizeQuestions": true
    },
    "BaseUrl": "#{BaseUrl}#"
  },
  "EmailSettings": {
    "SendGridApiKey": "#{SendGridApiKey}#",
    "FromEmail": "#{FromEmail}#",
    "FromName": "Quiz App"
  },
  "Paystack": {
    "PublicKey": "#{PaystackPublicKey}#",
    "SecretKey": "#{PaystackSecretKey}#",
    "CallbackUrl": "#{BaseUrl}#/subscription/verify",
    "PricingPlans": {
      "PremiumMonthly": "#{PaystackPremiumPlanCode}#",
      "ProMonthly": "#{PaystackProPlanCode}#"
    }
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 60
      },
      {
        "Endpoint": "*/quiz",
        "Period": "1h",
        "Limit": 20
      }
    ]
  }
}