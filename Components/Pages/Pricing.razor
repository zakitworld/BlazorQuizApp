@page "/pricing"
@using BlazorQuizApp.Models
@using BlazorQuizApp.Services
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using BlazorQuizApp.Configuration
@using Microsoft.Extensions.Options
@inject IPaystackPaymentService PaystackService
@inject ISubscriptionService SubscriptionService
@inject IOptions<PaystackSettings> PaystackOptions
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject INotificationService NotificationService

<PageTitle>Pricing - Quiz App</PageTitle>

<div class="pricing-page data-page-shell">
    <div class="container">
        <div class="pricing-hero text-center">
            <span class="eyebrow">Simple monthly plans</span><h1>Invest in visible progress.</h1>
            <p>Start free, then unlock deeper analytics, unlimited practice, and powerful learning tools when you’re ready.</p>
            <div class="billing-note"><i class="bi bi-shield-check"></i> Secure Paystack checkout · Cancel anytime · Prices in Ghana cedis</div>
        </div>

        <div class="row g-4 justify-content-center">
            @foreach (var tier in Enum.GetValues<SubscriptionTier>())
            {
                <div class="col-md-6 col-lg-3 animate__animated animate__fadeInUp" style="animation-delay: @((int)tier * 0.1)s">
                    <div class="card h-100 pricing-card @(tier == SubscriptionTier.Premium ? "featured-card" : "")">
                        @if (tier == SubscriptionTier.Premium)
                        {
                            <div class="featured-badge">MOST POPULAR</div>
                        }
                        
                        <div class="card-body p-4 d-flex flex-column">
                            <div class="text-center mb-4">
                                <h3 class="tier-name">@tier.GetDisplayName()</h3>
                                <div class="price-container">
                                    <span class="currency">GHS</span>
                                    <span class="amount">@tier.GetMonthlyPrice().ToString("N0")</span>
                                    <span class="period">/mo</span>
                                </div>
                            </div>

                            <div class="divider mb-4"></div>

                            <ul class="feature-list list-unstyled mb-4 flex-grow-1">
                                @foreach (var feature in tier.GetFeatures())
                                {
                                    <li class="mb-3 d-flex align-items-center">
                                        <div class="feature-icon-wrapper me-3">
                                            <i class="bi bi-check2 text-primary"></i>
                                        </div>
                                        <span class="feature-text text-muted">@feature</span>
                                    </li>
                                }
                            </ul>

                            <div class="action-wrapper mt-auto">
                                @if (currentTier == tier)
                                {
                                    <button class="btn btn-current w-100 py-3" disabled>
                                        <i class="bi bi-patch-check-fill me-2"></i>
                                        Active Plan
                                    </button>
                                }
                                else if (tier == SubscriptionTier.Free)
                                {
                                    <button class="btn btn-outline-secondary w-100 py-3" disabled>
                                        Free Tier
                                    </button>
                                }
                                else if (tier == SubscriptionTier.Enterprise)
                                {
                                    <a href="mailto:support@quizapp.com" class="btn btn-enterprise w-100 py-3">
                                        <i class="bi bi-envelope-paper me-2"></i>
                                        Contact Sales
                                    </a>
                                }
                                else
                                {
                                    <button class="btn @(tier == SubscriptionTier.Premium ? "btn-premium" : "btn-standard") w-100 py-3" 
                                            @onclick="() => HandleSubscribe(tier)"
                                            disabled="@isProcessing">
                                        @if (isProcessing && selectedTier == tier)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2"></span>
                                            <span>Processing...</span>
                                        }
                                        else
                                        {
                                            <span>@(currentTier < tier ? "Upgrade Now" : "Downgrade")</span>
                                            <i class="bi bi-arrow-right ms-2"></i>
                                        }
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="faq-section mt-5 py-5 animate__animated animate__fadeIn">
            <div class="row">
                <div class="col-lg-8 mx-auto">
                    <div class="glass-container p-5">
                        <h2 class="text-center mb-5 fw-bold">General Questions</h2>
                        <div class="accordion accordion-flush" id="faqAccordion">
                            <div class="accordion-item bg-transparent">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed bg-transparent fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
                                        Can I cancel my subscription anytime?
                                    </button>
                                </h2>
                                <div id="faq1" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                                    <div class="accordion-body text-muted">
                                        Yes, you can cancel at any time through your account settings. You'll maintain access to your features until the end of your current billing period.
                                    </div>
                                </div>
                            </div>
                            <div class="accordion-item bg-transparent">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed bg-transparent fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
                                        How does the payment process work?
                                    </button>
                                </h2>
                                <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                                    <div class="accordion-body text-muted">
                                        We use Paystack, a secure payment gateway. You can pay using your credit/debit card, mobile money (MTN, Vodafone, AirtelTigo), or bank transfer.
                                    </div>
                                </div>
                            </div>
                            <div class="accordion-item bg-transparent">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed bg-transparent fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">
                                        Are there any hidden fees?
                                    </button>
                                </h2>
                                <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                                    <div class="accordion-body text-muted">
                                        No hidden fees. The price you see is what you pay per month. All taxes and processing fees are included in the displayed amount.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .pricing-page {
        background: radial-gradient(circle at top right, rgba(0, 123, 255, 0.05), transparent),
                    radial-gradient(circle at bottom left, rgba(0, 123, 255, 0.05), transparent);
        min-height: 100vh;
    }

    .gradient-text {
        background: linear-gradient(135deg, #0d6efd 0%, #0dcaf0 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .pricing-card {
        border: 1px solid rgba(0, 0, 0, 0.05);
        border-radius: 20px;
        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
        background: white;
        position: relative;
        overflow: hidden;
    }

    .pricing-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
        border-color: rgba(13, 110, 253, 0.2);
    }

    .featured-card {
        border: 2px solid #0d6efd;
        transform: scale(1.03);
    }

    .featured-card:hover {
        transform: translateY(-10px) scale(1.05);
    }

    .featured-badge {
        position: absolute;
        top: 0;
        right: 0;
        background: #0d6efd;
        color: white;
        padding: 8px 16px;
        font-size: 0.75rem;
        font-weight: 700;
        border-bottom-left-radius: 20px;
        letter-spacing: 1px;
    }

    .tier-name {
        font-size: 1.5rem;
        font-weight: 700;
        color: #212529;
        margin-bottom: 1rem;
    }

    .price-container {
        display: flex;
        align-items: baseline;
        justify-content: center;
        gap: 4px;
    }

    .currency {
        font-size: 1rem;
        font-weight: 600;
        color: #6c757d;
        margin-bottom: 1rem;
    }

    .amount {
        font-size: 3rem;
        font-weight: 800;
        color: #212529;
    }

    .period {
        font-size: 1rem;
        color: #6c757d;
    }

    .divider {
        height: 1px;
        background: linear-gradient(to right, transparent, rgba(0,0,0,0.1), transparent);
    }

    .feature-icon-wrapper {
        width: 24px;
        height: 24px;
        background: rgba(13, 110, 253, 0.1);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .feature-text {
        font-size: 0.95rem;
    }

    .btn {
        border-radius: 12px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .btn-premium {
        background: linear-gradient(135deg, #0d6efd 0%, #004dc0 100%);
        color: white;
        border: none;
    }

    .btn-premium:hover {
        background: linear-gradient(135deg, #004dc0 0%, #003a91 100%);
        color: white;
        transform: translateY(-2px);
    }

    .btn-standard {
        border: 2px solid #0d6efd;
        color: #0d6efd;
        background: transparent;
    }

    .btn-standard:hover {
        background: #0d6efd;
        color: white;
        transform: translateY(-2px);
    }

    .btn-current {
        background: #f8f9fa;
        color: #198754;
        border: 1px solid #dee2e6;
    }

    .btn-enterprise {
        background: #212529;
        color: white;
        border: none;
    }

    .btn-enterprise:hover {
        background: #000;
        color: white;
        transform: translateY(-2px);
    }

    .glass-container {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(10px);
        border-radius: 30px;
        border: 1px solid rgba(255, 255, 255, 0.3);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
    }

    .accordion-button:not(.collapsed) {
        box-shadow: none;
        color: #0d6efd;
    }

    .accordion-item {
        border-bottom: 1px solid rgba(0,0,0,0.05);
    }
</style>

@code {
    private SubscriptionTier currentTier = SubscriptionTier.Free;
    private SubscriptionTier? selectedTier;
    private bool isProcessing = false;
    private string currentUserId = string.Empty;
    private string currentUserEmail = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            currentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
            currentUserEmail = authState.User.FindFirst(ClaimTypes.Email)?.Value ?? string.Empty;

            if (!string.IsNullOrEmpty(currentUserId))
            {
                currentTier = await SubscriptionService.GetUserTierAsync(currentUserId);
            }
        }
    }

    private async Task HandleSubscribe(SubscriptionTier tier)
    {
        if (string.IsNullOrEmpty(currentUserId))
        {
            NotificationService.ShowWarning("Please log in to subscribe.");
            NavigationManager.NavigateTo("/Account/Login");
            return;
        }

        if (string.IsNullOrWhiteSpace(PaystackOptions.Value.SecretKey))
        {
            NotificationService.ShowInfo("Payment processing is not yet configured. Please contact support to upgrade your plan.");
            return;
        }

        try
        {
            isProcessing = true;
            selectedTier = tier;
            StateHasChanged();

            var paymentUrl = await PaystackService.InitializePaymentAsync(currentUserId, currentUserEmail, tier);
            NavigationManager.NavigateTo(paymentUrl, true);
        }
        catch (Exception ex)
        {
            NotificationService.ShowError($"Failed to start payment: {ex.Message}");
        }
        finally
        {
            isProcessing = false;
            selectedTier = null;
            StateHasChanged();
        }
    }
}
