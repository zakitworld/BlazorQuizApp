@page "/quiz-result/{ResultId:int}"
@using BlazorQuizApp.Models
@using BlazorQuizApp.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@attribute [Authorize]
@inject IQuizBusinessService QuizBusinessService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject INotificationService NotificationService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>Quiz Result Details</PageTitle>

<div class="container-fluid">
    <LoadingSpinner IsLoading="@isLoading" Message="Loading quiz result..." />

    @if (!isLoading && quizResult != null)
    {
        <div class="row mb-4 align-items-center">
            <div class="col-md-8">
                <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                    <button class="btn btn-outline-secondary btn-sm" @onclick="GoBack">
                        <i class="bi bi-arrow-left me-1"></i>History
                    </button>
                    <span class="badge @QuizCategorySections.GetSectionBadgeClass(quizResult.Category) fs-6">
                        @QuizCategorySections.GetIcon(quizResult.Category) @(string.IsNullOrWhiteSpace(quizResult.Category) ? "General Knowledge" : quizResult.Category)
                    </span>
                    <span class="badge bg-light text-dark border">
                        @QuizCategorySections.GetSection(quizResult.Category)
                    </span>
                    @if (quizResult.IsPracticeMode)
                    {
                        <span class="badge bg-secondary-subtle text-secondary border">Practice Mode</span>
                    }
                </div>
                <h1 class="display-6 mb-1">
                    <i class="bi bi-clipboard-check text-primary me-2"></i>
                    Assessment Result Details
                </h1>
                <p class="text-muted mb-0">Completed on @quizResult.CompletedAt.ToString("MMMM dd, yyyy 'at' HH:mm")</p>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <a href="@($"/quiz?category={Uri.EscapeDataString(quizResult.Category ?? "")}")" class="btn btn-primary">
                    <i class="bi bi-arrow-repeat me-1"></i>Retake Quiz / Exam
                </a>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-md-3">
                <div class="card bg-primary text-white">
                    <div class="card-body text-center">
                        <i class="bi bi-percent display-4 mb-2"></i>
                        <h3 class="card-title">@quizResult.ScorePercentage.ToString("F1")%</h3>
                        <p class="card-text">Score</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-success text-white">
                    <div class="card-body text-center">
                        <i class="bi bi-check-circle display-4 mb-2"></i>
                        <h3 class="card-title">@quizResult.CorrectAnswers</h3>
                        <p class="card-text">Correct</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-info text-white">
                    <div class="card-body text-center">
                        <i class="bi bi-question-circle display-4 mb-2"></i>
                        <h3 class="card-title">@quizResult.TotalQuestions</h3>
                        <p class="card-text">Total Questions</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-warning text-dark">
                    <div class="card-body text-center">
                        <i class="bi bi-clock display-4 mb-2"></i>
                        <h3 class="card-title">@quizResult.Duration.ToString(@"mm\:ss")</h3>
                        <p class="card-text">Duration</p>
                    </div>
                </div>
            </div>
        </div>

        @if (QuizCategorySections.IsStandardizedExam(quizResult.Category))
        {
            var isWaec = QuizCategorySections.GetSection(quizResult.Category) == QuizCategorySections.Waec;
            var isLicensure = QuizCategorySections.GetSection(quizResult.Category) == QuizCategorySections.Licensure;

            <div class="card mb-4 border-primary shadow-sm">
                <div class="card-header bg-primary text-white d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <span class="fw-semibold">
                        <i class="bi bi-mortarboard-fill me-2"></i>Official Standardized Examination Evaluation
                    </span>
                    <span class="badge bg-light text-primary">@quizResult.Category</span>
                </div>
                <div class="card-body">
                    @if (isWaec)
                    {
                        var stanine = ComputeWaecStanine(quizResult.ScorePercentage);
                        <div class="row align-items-center">
                            <div class="col-md-4 text-center border-end">
                                <div class="display-4 fw-bold text-primary">@stanine.Grade</div>
                                <div class="badge bg-primary fs-6 px-3 py-1">@stanine.Remarks</div>
                            </div>
                            <div class="col-md-8 ps-md-4 mt-3 mt-md-0">
                                <h6 class="fw-bold mb-1">WAEC Official Stanine Scale Conversion</h6>
                                <p class="text-muted mb-2">@stanine.Description</p>
                                <div class="small text-secondary">
                                    <i class="bi bi-info-circle me-1"></i>
                                    Grading follows official West African Examinations Council stanine metrics (Grade 1 Distinction down to Grade 9 Fail).
                                </div>
                            </div>
                        </div>
                    }
                    else if (isLicensure)
                    {
                        var evalResult = ComputeLicensureEvaluation(quizResult.ScorePercentage);
                        <div class="row align-items-center">
                            <div class="col-md-4 text-center border-end">
                                <div class="display-5 fw-bold @evalResult.BadgeClass">@evalResult.Status</div>
                                <div class="badge @(evalResult.Passed ? "bg-success" : "bg-danger") fs-6 px-3 py-1 mt-1">@evalResult.Band</div>
                            </div>
                            <div class="col-md-8 ps-md-4 mt-3 mt-md-0">
                                <h6 class="fw-bold mb-1">Licensure & Promotion Standards Board</h6>
                                <p class="text-muted mb-2">@evalResult.Advice</p>
                                <div class="small text-secondary">
                                    <i class="bi bi-shield-check me-1"></i>
                                    Evaluated against NTC Ghana Licensure / GES Promotion Examination benchmarks (Pass mark: 60%+).
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        @if (quizResult.Answers != null && quizResult.Answers.Any())
        {
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-0">
                                <i class="bi bi-list-check me-2"></i>
                                Question Review
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                @foreach (var answer in quizResult.Answers.OrderBy(a => a.QuestionId))
                                {
                                    var question = questionCache.ContainsKey(answer.QuestionId)
                                        ? questionCache[answer.QuestionId]
                                        : null;
                                    if (question != null)
                                    {
                                        <div class="col-12">
                                            <div class="card @(answer.SelectedOptionId == question.CorrectOptionId ? "border-success" : "border-danger")">
                                                <div class="card-body">
                                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                                        <h6 class="card-title mb-0">@question.QuestionText</h6>
                                                        @if (answer.SelectedOptionId == question.CorrectOptionId)
                                                        {
                                                            <span class="badge bg-success">
                                                                <i class="bi bi-check-circle me-1"></i>Correct
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-danger">
                                                                <i class="bi bi-x-circle me-1"></i>Incorrect
                                                            </span>
                                                        }
                                                    </div>
                                                    <div class="mt-2">
                                                        @foreach (var option in question.Options)
                                                        {
                                                            var isSelected = option.Id == answer.SelectedOptionId;
                                                            var isCorrect = option.Id == question.CorrectOptionId;
                                                            <div class="mb-2 p-3 rounded @(isCorrect ? "bg-success bg-opacity-10 border border-success" : isSelected ? "bg-danger bg-opacity-10 border border-danger" : "bg-light")">
                                                                <div class="d-flex align-items-center">
                                                                    @if (isCorrect)
                                                                    {
                                                                        <i class="bi bi-check-circle-fill text-success me-2 fs-5"></i>
                                                                    }
                                                                    else if (isSelected)
                                                                    {
                                                                        <i class="bi bi-x-circle-fill text-danger me-2 fs-5"></i>
                                                                    }
                                                                    else
                                                                    {
                                                                        <i class="bi bi-circle me-2 text-muted"></i>
                                                                    }
                                                                    <span class="@(isSelected ? "fw-bold" : "")">@option.Text</span>
                                                                    @if (isCorrect)
                                                                    {
                                                                        <span class="badge bg-success ms-auto">Correct Answer</span>
                                                                    }
                                                                    @if (isSelected && !isCorrect)
                                                                    {
                                                                        <span class="badge bg-danger ms-auto">Your Answer</span>
                                                                    }
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else if (!isLoading && quizResult == null)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle me-2"></i>
            Quiz result not found or you don't have permission to view it.
        </div>
        <button class="btn btn-primary" @onclick="GoBack">Go Back</button>
    }
</div>

@code {
    [Parameter] public int ResultId { get; set; }
    
    private QuizResult? quizResult;
    private bool isLoading = true;
    private string currentUserId = string.Empty;
    private Dictionary<int, QuizQuestion> questionCache = new();
    private bool celebrationTriggered;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!celebrationTriggered && !isLoading && quizResult?.IsPassed == true)
        {
            celebrationTriggered = true;
            var intensity = quizResult.ScorePercentage >= 99.5 ? "perfect" : "pass";
            await JS.InvokeVoidAsync("quizCelebration.show", $"result-{quizResult.Id}", intensity);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                currentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
            }

            quizResult = await QuizBusinessService.GetQuizResultByIdAsync(ResultId, currentUserId);

            if (quizResult != null && quizResult.Answers != null)
            {
                // Pre-load all questions for this result
                await LoadAllQuestionsForResult();
            }
        }
        catch (Exception)
        {
            NotificationService.ShowError("Failed to load quiz result. Please try again later.");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadAllQuestionsForResult()
    {
        if (quizResult?.Answers == null) return;

        foreach (var answer in quizResult.Answers)
        {
            if (!questionCache.ContainsKey(answer.QuestionId))
            {
                if (!string.IsNullOrWhiteSpace(answer.QuestionTextSnapshot))
                {
                    var options = new List<QuizOption>
                    {
                        new() { Id = 1, Text = answer.SelectedAnswerSnapshot ?? "Skipped" }
                    };
                    var correctId = 1;
                    if (!answer.IsCorrect && !string.IsNullOrWhiteSpace(answer.CorrectAnswerSnapshot))
                    {
                        correctId = 2;
                        options.Add(new QuizOption { Id = 2, Text = answer.CorrectAnswerSnapshot });
                    }
                    answer.SelectedOptionId = 1;
                    questionCache[answer.QuestionId] = new QuizQuestion
                    {
                        Id = answer.QuestionId,
                        QuestionText = answer.QuestionTextSnapshot,
                        CorrectOptionId = correctId,
                        Options = options
                    };
                    continue;
                }

                try
                {
                    var question = await QuizBusinessService.GetQuestionByIdAsync(answer.QuestionId);
                    if (question != null)
                    {
                        questionCache[answer.QuestionId] = question;
                    }
                }
                catch
                {
                    // Skip if question not found
                }
            }
        }
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/quiz-history");
    }

    private (string Grade, string Remarks, string Description) ComputeWaecStanine(double score)
    {
        return score switch
        {
            >= 80 => ("Grade 1", "Distinction", "Outstanding mastery of the curriculum, exceptional performance."),
            >= 75 => ("Grade 2", "Distinction", "Strong analytical grasp and very high competency."),
            >= 70 => ("Grade 3", "Merit", "Above average understanding across syllabus objectives."),
            >= 65 => ("Grade 4", "Credit", "Good standard performance; solid foundation."),
            >= 60 => ("Grade 5", "Credit", "Satisfactory completion of core competencies."),
            >= 50 => ("Grade 6", "Credit", "Meets minimum credit requirements for certification."),
            >= 45 => ("Grade 7", "Pass", "Basic pass level; recommended to revise weak topics."),
            >= 40 => ("Grade 8", "Pass", "Weak pass; needs dedicated practice and remediation."),
            _ => ("Grade 9", "Fail", "Below passing threshold; comprehensive review required.")
        };
    }

    private (string Status, string Band, string BadgeClass, string Advice, bool Passed) ComputeLicensureEvaluation(double score)
    {
        if (score >= 80)
            return ("Passed with Honours", "Professional Master (Tier 1)", "text-success", "Exemplary pedagogy, subject matter mastery, and code of conduct demonstrated.", true);
        if (score >= 60)
            return ("Qualified / Recommended", "Standard Pass (Tier 2)", "text-success", "Meets the official national regulatory benchmark for licensure and promotion.", true);
        if (score >= 50)
            return ("Borderline Deficiency", "Conditional Remediation", "text-warning", "Near pass mark. Review educational policies and curriculum guides before re-assessment.", false);

        return ("Unsuccessful - Resit Needed", "Remediation Required", "text-danger", "Did not satisfy the minimum required passing score. Dedicated revision strongly advised.", false);
    }
}

