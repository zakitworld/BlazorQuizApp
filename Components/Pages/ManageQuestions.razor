@page "/manage-questions"
@using BlazorQuizApp.Models
@attribute [Authorize(Roles = "Admin")]
@using BlazorQuizApp.Services
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization
@inject IQuizBusinessService QuizBusinessService
@inject INotificationService NotificationService
@inject NavigationManager NavigationManager
@inject ApplicationDbContext Db

<div class="page-header">
    <div class="container">
        <h1 class="mb-0">Manage Quiz Questions</h1>
    </div>
</div>

<div class="container pb-5">

<LoadingSpinner IsLoading="@isLoading" Message="Loading questions..." />

@if (!isLoading && questions.Any())
{
    <div class="mb-4">
        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <input type="text" class="form-control" placeholder="Search questions..." @bind="searchTerm" @bind:event="oninput" />
            </div>
            <div class="col-md-3">
                <select class="form-select" @bind="selectedCategory">
                    <option value="">All Categories</option>
                    @foreach (var category in categories) { <option value="@category.Name">@category.Name@(!category.IsActive ? " (retired)" : "")</option> }
                </select>
            </div>
            <div class="col-md-3">
                <select class="form-select" @bind="selectedDifficulty">
                    <option value="">All Difficulties</option>
                    <option value="Easy">Easy</option>
                    <option value="Medium">Medium</option>
                    <option value="Hard">Hard</option>
                </select>
            </div>
            <div class="col-md-2">
                <button class="btn btn-outline-secondary w-100" @onclick="ResetFilters">
                    <i class="bi bi-arrow-clockwise me-1"></i>Reset
                </button>
            </div>
        </div>
    </div>

    <div class="questions-list mb-4">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="bi bi-list-ul me-2"></i>
                    Questions (@FilteredQuestions.Count() of @questions.Count)
                </h5>
            </div>
            <div class="card-body">
                @foreach (var question in FilteredQuestions)
                {
                    <div class="question-item border-bottom pb-3 mb-3">
                        <div class="row align-items-start">
                            <div class="col-12 col-md-8 mb-2 mb-md-0">
                                <div class="d-flex gap-2 mb-2">
                                    <span class="badge bg-primary">@question.Category</span>
                                    <span class="badge bg-secondary">@question.Difficulty</span>
                                </div>
                                <h6 class="mb-2">@question.QuestionText</h6>
                                <div class="options-list">
                                    @foreach (var option in question.Options)
                                    {
                                        <span class="badge @(option.Id == question.CorrectOptionId ? "bg-success" : "bg-light text-dark") me-2 mb-1">
                                            @option.Text
                                        </span>
                                    }
                                </div>
                            </div>
                            <div class="col-12 col-md-4 text-md-end">
                                <div class="btn-group-vertical btn-group-sm d-md-none w-100 mb-2" role="group">
                                    <a href="/question-details/@question.Id" class="btn btn-info">
                                        <i class="bi bi-eye me-1"></i>Details
                                    </a>
                                    <a href="/edit-question/@question.Id" class="btn btn-warning">
                                        <i class="bi bi-pencil me-1"></i>Edit
                                    </a>
                                    <button class="btn btn-danger" @onclick="() => DeleteQuestion(question.Id)">
                                        <i class="bi bi-trash me-1"></i>Delete
                                    </button>
                                </div>
                                <div class="btn-group d-none d-md-inline-flex" role="group">
                                    <a href="/question-details/@question.Id" class="btn btn-info btn-sm">
                                        <i class="bi bi-eye me-1"></i>Details
                                    </a>
                                    <a href="/edit-question/@question.Id" class="btn btn-warning btn-sm">
                                        <i class="bi bi-pencil me-1"></i>Edit
                                    </a>
                                    <button class="btn btn-danger btn-sm" @onclick="() => DeleteQuestion(question.Id)">
                                        <i class="bi bi-trash me-1"></i>Delete
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                
                @if (!FilteredQuestions.Any())
                {
                    <div class="text-center py-4">
                        <i class="bi bi-search text-muted" style="font-size: 3rem;"></i>
                        <p class="text-muted mt-2">No questions found matching your criteria.</p>
                    </div>
                }
            </div>
        </div>
    </div>
}
else if (!isLoading && !questions.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>
        No questions available. Add your first question below!
    </div>
}

<div class="add-question-form">
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">
                <i class="bi bi-plus-circle me-2"></i>
                Add New Question
            </h5>
        </div>
        <div class="card-body">
            <EditForm Model="@newQuestion" OnValidSubmit="HandleValidSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="form-group mb-3">
                    <label for="questionText" class="form-label">Question Text</label>
                    <InputText id="questionText" @bind-Value="newQuestion.QuestionText" class="form-control" />
                    <ValidationMessage For="@(() => newQuestion.QuestionText)" />
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label for="category" class="form-label">Category</label>
                        <InputSelect id="category" @bind-Value="newQuestion.Category" class="form-select">
                            @foreach (var category in categories.Where(x => x.IsActive)) { <option value="@category.Name">@category.Name</option> }
                        </InputSelect>
                        <ValidationMessage For="@(() => newQuestion.Category)" />
                    </div>
                    <div class="col-md-6">
                        <label for="difficulty" class="form-label">Difficulty</label>
                        <InputSelect id="difficulty" @bind-Value="newQuestion.Difficulty" class="form-select">
                            <option value="Easy">Easy</option>
                            <option value="Medium">Medium</option>
                            <option value="Hard">Hard</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => newQuestion.Difficulty)" />
                    </div>
                </div>

                <div class="options-section mb-3">
                    <label class="form-label">Options</label>
                    @for (int i = 0; i < newQuestion.OptionTexts.Count; i++)
                    {
                        var index = i;
                        <div class="input-group mb-2">
                            <span class="input-group-text">@(index + 1)</span>
                            <InputText class="form-control" @bind-Value="newQuestion.OptionTexts[index]" 
                                     placeholder="@($"Enter option {index + 1}")" />
                            @if (newQuestion.OptionTexts.Count > 2)
                            {
                                <button type="button" class="btn btn-outline-danger" @onclick="() => RemoveOption(index)">
                                    <i class="bi bi-dash"></i>
                                </button>
                            }
                        </div>
                    }
                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="AddOption">
                        <i class="bi bi-plus me-1"></i>Add Option
                    </button>
                </div>

                <div class="form-group mb-3">
                    <label for="correctOption" class="form-label">Correct Option</label>
                    <InputSelect id="correctOption" @bind-Value="newQuestion.CorrectOptionIndex" class="form-control">
                        @for (int i = 0; i < newQuestion.OptionTexts.Count; i++)
                        {
                            <option value="@i">Option @(i + 1): @newQuestion.OptionTexts[i]</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => newQuestion.CorrectOptionIndex)" />
                </div>

                <div class="form-group mb-3">
                    <label for="explanation" class="form-label">
                        Explanation <span class="text-muted small">(optional — shown after answering)</span>
                    </label>
                    <InputTextArea id="explanation" @bind-Value="newQuestion.Explanation" class="form-control" rows="3"
                                   placeholder="Explain why the correct answer is correct..." />
                    <ValidationMessage For="@(() => newQuestion.Explanation)" />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span>Adding...</span>
                        }
                        else
                        {
                            <i class="bi bi-plus-circle me-1"></i>
                            <span>Add Question</span>
                        }
                    </button>
                    <button type="button" class="btn btn-secondary" @onclick="ResetForm">
                        <i class="bi bi-arrow-clockwise me-1"></i>Reset
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private List<QuizQuestion> questions = new();
    private NewQuestionForm newQuestion = new();
    private bool isLoading = true;
    private bool isSubmitting = false;
    private string searchTerm = string.Empty;
    private string selectedCategory = string.Empty;
    private string selectedDifficulty = string.Empty;
    private List<QuizCategory> categories = [];

    private IEnumerable<QuizQuestion> FilteredQuestions =>
        questions.Where(q =>
            (string.IsNullOrEmpty(searchTerm) || q.QuestionText.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrEmpty(selectedCategory) || q.Category.Equals(selectedCategory, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrEmpty(selectedDifficulty) || q.Difficulty.Equals(selectedDifficulty, StringComparison.OrdinalIgnoreCase))
        );

    protected override async Task OnInitializedAsync()
    {
        categories = await Db.QuizCategories.AsNoTracking().OrderBy(x => x.SortOrder).ThenBy(x => x.Name).ToListAsync();
        if (categories.Any(x => x.IsActive) && categories.All(x => x.Name != newQuestion.Category)) newQuestion.Category = categories.First(x => x.IsActive).Name;
        await LoadQuestions();
    }

    private async Task LoadQuestions()
    {
        try
        {
            isLoading = true;
            questions = await QuizBusinessService.GetQuestionsAsync();
        }
        catch (Exception)
        {
            NotificationService.ShowError("Failed to load questions. Please try again later.");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            isSubmitting = true;
            var success = await QuizBusinessService.AddQuestionAsync(newQuestion);
            
            if (success)
            {
                NotificationService.ShowSuccess("Question added successfully!");
                await LoadQuestions();
                ResetForm();
            }
            else
            {
                NotificationService.ShowError("Failed to add question. Please check your input and try again.");
            }
        }
        catch (Exception)
        {
            NotificationService.ShowError("An error occurred while adding the question. Please try again.");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task DeleteQuestion(int id)
    {
        try
        {
            var success = await QuizBusinessService.DeleteQuestionAsync(id);
            
            if (success)
            {
                NotificationService.ShowSuccess("Question deleted successfully!");
                await LoadQuestions();
            }
            else
            {
                NotificationService.ShowError("Failed to delete question. Please try again.");
            }
        }
        catch (Exception)
        {
            NotificationService.ShowError("An error occurred while deleting the question. Please try again.");
        }
    }

    private void AddOption()
    {
        newQuestion.OptionTexts.Add(string.Empty);
    }

    private void RemoveOption(int index)
    {
        if (newQuestion.OptionTexts.Count > 2)
        {
            newQuestion.OptionTexts.RemoveAt(index);
            if (newQuestion.CorrectOptionIndex >= newQuestion.OptionTexts.Count)
            {
                newQuestion.CorrectOptionIndex = newQuestion.OptionTexts.Count - 1;
            }
        }
    }

    private void ResetForm()
    {
        newQuestion = new NewQuestionForm();
        if (categories.Any(x => x.IsActive)) newQuestion.Category = categories.First(x => x.IsActive).Name;
    }

    private void ResetFilters()
    {
        searchTerm = string.Empty;
        selectedCategory = string.Empty;
        selectedDifficulty = string.Empty;
    }
}
</div>
