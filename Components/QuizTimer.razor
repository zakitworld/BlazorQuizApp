@using System.Timers
@implements IDisposable

<div class="quiz-timer @GetTimerClass()">
    <div class="timer-display">
        <i class="bi bi-clock me-2"></i>
        <span class="timer-text">@FormatTime(TimeRemaining)</span>
    </div>
    @if (ShowProgressBar)
    {
        <div class="progress mt-2" style="height: 4px;">
            <div class="progress-bar @GetProgressBarClass()"
                 style="width: @(GetProgressPercentage().ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%"
                 role="progressbar"
                 aria-valuenow="@GetProgressPercentage()"
                 aria-valuemin="0"
                 aria-valuemax="100">
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int DurationSeconds { get; set; } = 45;

    [Parameter]
    public bool ShowProgressBar { get; set; } = true;

    [Parameter]
    public EventCallback OnTimeUp { get; set; }

    [Parameter]
    public EventCallback<int> OnTimeChanged { get; set; }

    private Timer? _timer;
    private int _timeRemaining;
    private bool _isDisposed;

    // Warning thresholds as fractions of total duration
    private int WarnYellowAt => Math.Max(10, (int)(DurationSeconds * 0.25));
    private int WarnRedAt    => Math.Max(5,  (int)(DurationSeconds * 0.10));

    public int TimeRemaining => _timeRemaining;

    protected override void OnParametersSet()
    {
        // Restart when DurationSeconds changes (new quiz or category change)
        StopTimer();
        _timeRemaining = DurationSeconds;
        _isDisposed = false;
        StartTimer();
    }

    private void StartTimer()
    {
        _timer = new Timer(1000);
        _timer.Elapsed += OnTimerElapsed;
        _timer.AutoReset = true;
        _timer.Start();
    }

    private async void OnTimerElapsed(object? sender, ElapsedEventArgs e)
    {
        if (_isDisposed) return;

        _timeRemaining--;

        await InvokeAsync(async () =>
        {
            await OnTimeChanged.InvokeAsync(_timeRemaining);
            StateHasChanged();

            if (_timeRemaining <= 0)
            {
                await OnTimeUp.InvokeAsync();
                StopTimer();
            }
        });
    }

    public void StopTimer()
    {
        _timer?.Stop();
        _timer?.Dispose();
        _timer = null;
    }

    public void ResetTimer()
    {
        _timeRemaining = DurationSeconds;
        StateHasChanged();
    }

    private static string FormatTime(int seconds)
    {
        var minutes = seconds / 60;
        var remainingSeconds = seconds % 60;
        return $"{minutes:D2}:{remainingSeconds:D2}";
    }

    private string GetTimerClass() =>
        _timeRemaining <= WarnRedAt    ? "text-danger" :
        _timeRemaining <= WarnYellowAt ? "text-warning" :
                                         "text-primary";

    private string GetProgressBarClass() =>
        _timeRemaining <= WarnRedAt    ? "bg-danger" :
        _timeRemaining <= WarnYellowAt ? "bg-warning" :
                                         "bg-primary";

    private double GetProgressPercentage() =>
        DurationSeconds > 0 ? Math.Max(0, (double)_timeRemaining / DurationSeconds * 100) : 0;

    public void Dispose()
    {
        _isDisposed = true;
        StopTimer();
    }
}
