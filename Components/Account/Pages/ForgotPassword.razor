@page "/Account/ForgotPassword"
@attribute [ExcludeFromInteractiveRouting]

<PageTitle>Forgot password | Quiz App</PageTitle>
<div class="auth-bg"><div class="auth-card">
    <div class="auth-logo">Q</div>
    <h1 class="auth-title">Reset password</h1>
    @if (Sent)
    {
        <div class="alert alert-success">If that confirmed account exists, a reset link has been sent.</div>
    }
    else
    {
        <p class="auth-subtitle">Enter your confirmed account email.</p>
        <form action="/Account/ForgotPassword" method="post">
            <AntiforgeryToken />
            <input type="email" name="email" class="form-control auth-input mb-3" autocomplete="email" required maxlength="256" />
            <button class="btn btn-primary w-100" type="submit">Send reset link</button>
        </form>
    }
</div></div>

@code {
    [SupplyParameterFromQuery] private bool Sent { get; set; }
}
