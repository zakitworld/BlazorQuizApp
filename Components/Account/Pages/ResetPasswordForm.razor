@page "/Account/ResetPasswordForm"
@attribute [ExcludeFromInteractiveRouting]

<PageTitle>Reset password | Quiz App</PageTitle>
<div class="auth-bg"><div class="auth-card">
    <div class="auth-logo">Q</div>
    <h1 class="auth-title">Choose a new password</h1>
    @if (!string.IsNullOrEmpty(Error))
    {
        <div class="alert alert-danger">The reset link or password is invalid.</div>
    }
    <form action="/Account/ResetPassword" method="post">
        <AntiforgeryToken />
        <input type="hidden" name="email" value="@Email" />
        <input type="hidden" name="code" value="@Code" />
        <input type="password" name="password" class="form-control auth-input mb-3" autocomplete="new-password" required minlength="8" placeholder="New password" />
        <input type="password" name="confirmPassword" class="form-control auth-input mb-3" autocomplete="new-password" required minlength="8" placeholder="Confirm password" />
        <button class="btn btn-primary w-100" type="submit">Reset password</button>
    </form>
</div></div>

@code {
    [SupplyParameterFromQuery] private string Email { get; set; } = string.Empty;
    [SupplyParameterFromQuery] private string Code { get; set; } = string.Empty;
    [SupplyParameterFromQuery] private string? Error { get; set; }
}
