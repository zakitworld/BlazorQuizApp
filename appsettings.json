{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=(localdb)\\MSSQLLocalDB;Initial Catalog=BlazorQuizApp;Integrated Security=True;Trust Server Certificate=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AppSettings": {
    "AdminUser": {
      "Email": "zakitworld@gmail.com"
    },
    "Quiz": {
      "DefaultTimeLimit": 300,
      "MaxQuestionsPerQuiz": 10,
      "RandomizeQuestions": true,
      "FreeMonthlyLimit": 5
    },
    "BaseUrl": "https://localhost:7233"
  },
  "EmailSettings": {
    "SendGridApiKey": "",
    "FromEmail": "noreply@quizapp.com",
    "FromName": "Quiz App"
  },
  "Paystack": {
    "PublicKey": "",
    "SecretKey": "",
    "CallbackUrl": "https://localhost:7233/subscription/verify",
    "PricingPlans": {
      "PremiumMonthly": "PLN_premium_monthly",
      "ProMonthly": "PLN_pro_monthly"
    }
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 100
      },
      {
        "Endpoint": "*/quiz",
        "Period": "1h",
        "Limit": 50
      }
    ]
  }
}