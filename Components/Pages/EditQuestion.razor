@page "/edit-question/{id:int}"
@using BlazorQuizApp.Models
@using BlazorQuizApp.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@attribute [Authorize(Roles = "Admin")]
@inject IQuizBusinessService QuizBusinessService
@inject INotificationService NotificationService
@inject NavigationManager NavigationManager
@inject ApplicationDbContext Db

<h1>Edit Question</h1>

<LoadingSpinner IsLoading="@isLoading" Message="Loading question..." />

@if (!isLoading && question == null)

{
    <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle me-2"></i>
        Question not found.
    </div>
    <a href="/manage-questions" class="btn btn-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back to Questions
    </a>
}

else if (!isLoading && question != null)

{
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">
                <i class="bi bi-pencil me-2"></i>
                Edit Question #@Id
            </h5>
        </div>
        <div class="card-body">
            <EditForm Model="@questionForm" OnValidSubmit="HandleValidSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="form-group mb-3">
                    <label for="questionText" class="form-label">Question Text</label>
                    <InputText id="questionText" @bind-Value="questionForm.QuestionText" class="form-control" />
                    <ValidationMessage For="@(() => questionForm.QuestionText)" />
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label for="category" class="form-label">Category</label>
                        <InputSelect id="category" @bind-Value="questionForm.Category" class="form-select">
                            @foreach (var group in categories.Where(x => x.IsActive || x.Name == questionForm.Category).GroupBy(c => QuizCategorySections.GetSection(c.Name)))
                            {
                                <optgroup label="@group.Key">
                                    @foreach (var category in group)
                                    {
                                        <option value="@category.Name">@QuizCategorySections.GetIcon(category.Name) @category.Name@(!category.IsActive ? " (retired)" : "")</option>
                                    }
                                </optgroup>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => questionForm.Category)" />
                    </div>
                    <div class="col-md-6">
                        <label for="difficulty" class="form-label">Difficulty</label>
                        <InputSelect id="difficulty" @bind-Value="questionForm.Difficulty" class="form-select">
                            <option value="Easy">Easy</option>
                            <option value="Medium">Medium</option>
                            <option value="Hard">Hard</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => questionForm.Difficulty)" />
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label class="form-label">Answer format</label>
                    <InputSelect @bind-Value="questionForm.Type" class="form-select">
                        <option value="@QuestionType.MultipleChoice">Single choice</option>
                        <option value="@QuestionType.MultipleSelect">Multiple select</option>
                        <option value="@QuestionType.TrueFalse">True / false</option>
                        <option value="@QuestionType.ShortAnswer">Short answer</option>
                    </InputSelect>
                </div>

                @if (questionForm.Type == QuestionType.ShortAnswer)
                {
                    <div class="form-group mb-3"><label class="form-label">Accepted answers</label><InputText @bind-Value="questionForm.AcceptedAnswers" class="form-control" placeholder="Separate alternatives with semicolons" /></div>
                }
                else
                {
                <div class="options-section mb-3">
                    <label class="form-label">Options</label>
                    @for (int i = 0; i < questionForm.OptionTexts.Count; i++)
                    {

                        var index = i;
                        <div class="input-group mb-2">
                            <span class="input-group-text">@(index + 1)</span>
                            <InputText class="form-control" @bind-Value="questionForm.OptionTexts[index]"
                                placeholder="@($"Enter option {index + 1}")" />
                            @if (questionForm.OptionTexts.Count > 2)
                            {
                                <button type="button" class="btn btn-outline-danger" @onclick="() => RemoveOption(index)">
                                    <i class="bi bi-dash"></i>
                                </button>
                            }
                        </div>
                    }
                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="AddOption">
                        <i class="bi bi-plus me-1"></i>Add Option
                    </button>
                </div>

                @if (questionForm.Type == QuestionType.MultipleSelect)
                {
                    <div class="form-group mb-3"><label class="form-label">Correct options</label>
                    @for (var i = 0; i < questionForm.OptionTexts.Count; i++)
                    {
                        var optionIndex = i;
                        <label class="form-check"><input class="form-check-input" type="checkbox" checked="@questionForm.CorrectOptionIndexes.Contains(optionIndex)" @onchange="e => ToggleCorrect(optionIndex, (bool?)e.Value == true)" /><span class="form-check-label">Option @(optionIndex + 1)</span></label>
                    }
                    </div>
                }
                else
                {
                <div class="form-group mb-3">
                    <label for="correctOption" class="form-label">Correct Option</label>
                    <InputSelect id="correctOption" @bind-Value="questionForm.CorrectOptionIndex" class="form-control">
                        @for (int i = 0; i < questionForm.OptionTexts.Count; i++)
                        {
                            <option value="@i">Option @(i + 1): @questionForm.OptionTexts[i]</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => questionForm.CorrectOptionIndex)" />
                </div>
                }
                }

                <div class="form-group mb-3">
                    <label for="explanation" class="form-label">
                        Explanation <span class="text-muted small">(optional — shown after answering)</span>
                    </label>
                    <InputTextArea id="explanation" @bind-Value="questionForm.Explanation" class="form-control" rows="3"
                                   placeholder="Explain why the correct answer is correct..." />
                    <ValidationMessage For="@(() => questionForm.Explanation)" />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
                        @if (isSubmitting)

                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span>Saving...</span>
                        }

                        else

                        {
                            <i class="bi bi-check-circle me-1"></i>
                            <span>Save Changes</span>
                        }
                    </button>
                    <a href="/manage-questions" class="btn btn-secondary">
                        <i class="bi bi-x-circle me-1"></i>Cancel
                    </a>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter]

    public int Id { get; set; }



    private QuizQuestion? question;

    private NewQuestionForm questionForm = new();

    private bool isLoading = true;

    private bool isSubmitting = false;
    private List<QuizCategory> categories = [];



    protected override async Task OnInitializedAsync()

    {

        categories = await Db.QuizCategories.AsNoTracking().OrderBy(x => x.SortOrder).ThenBy(x => x.Name).ToListAsync();
        await LoadQuestion();

    }



    private async Task LoadQuestion()

    {

        try

        {

            isLoading = true;

            question = await QuizBusinessService.GetQuestionByIdAsync(Id);



            if (question != null)

            {

                questionForm.QuestionText = question.QuestionText;
                questionForm.Category = question.Category;
                questionForm.Difficulty = question.Difficulty;
                questionForm.Explanation = question.Explanation;
                questionForm.Type = question.Type;
                questionForm.OptionTexts = question.Options.Select(o => o.Text).ToList();
                var correctOption = question.Options.FirstOrDefault(o => o.Id == question.CorrectOptionId);
                questionForm.CorrectOptionIndex = correctOption != null
                    ? question.Options.IndexOf(correctOption)
                    : 0;
                if (!string.IsNullOrWhiteSpace(question.CorrectOptionIdsJson))
                {
                    var correctIds = System.Text.Json.JsonSerializer.Deserialize<List<int>>(question.CorrectOptionIdsJson) ?? [];
                    questionForm.CorrectOptionIndexes = question.Options.Select((option, index) => new { option.Id, index })
                        .Where(x => correctIds.Contains(x.Id)).Select(x => x.index).ToList();
                }
                if (!string.IsNullOrWhiteSpace(question.AcceptedAnswersJson))
                {
                    var accepted = System.Text.Json.JsonSerializer.Deserialize<List<string>>(question.AcceptedAnswersJson) ?? [];
                    questionForm.AcceptedAnswers = string.Join("; ", accepted);
                }

            }

        }

        catch (Exception)

        {

            NotificationService.ShowError("Failed to load question. Please try again later.");

        }

        finally

        {

            isLoading = false;

        }

    }



    private async Task HandleValidSubmit()

    {

        try

        {

            isSubmitting = true;

            var success = await QuizBusinessService.UpdateQuestionAsync(Id, questionForm);



            if (success)

            {

                NotificationService.ShowSuccess("Question updated successfully!");

                NavigationManager.NavigateTo("/manage-questions");

            }

            else

            {

                NotificationService.ShowError("Failed to update question. Please check your input and try again.");

            }

        }

        catch (Exception)

        {

            NotificationService.ShowError("An error occurred while updating the question. Please try again.");

        }

        finally

        {

            isSubmitting = false;

        }

    }



    private void AddOption()

    {

        questionForm.OptionTexts.Add(string.Empty);

    }

    private void ToggleCorrect(int index, bool selected)
    {
        if (selected && !questionForm.CorrectOptionIndexes.Contains(index)) questionForm.CorrectOptionIndexes.Add(index);
        else if (!selected) questionForm.CorrectOptionIndexes.Remove(index);
    }



    private void RemoveOption(int index)

    {

        if (questionForm.OptionTexts.Count > 2)

        {

            questionForm.OptionTexts.RemoveAt(index);

            if (questionForm.CorrectOptionIndex >= questionForm.OptionTexts.Count)

            {

                questionForm.CorrectOptionIndex = questionForm.OptionTexts.Count - 1;

            }

        }

    }
}
