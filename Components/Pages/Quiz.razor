    .option-btn { background:#fff; border-color:#dee2e6; }
    .option-btn:hover:not(:disabled) { border-color:#0d6efd; background:#f0f5ff; }
    .option-btn.selected-exam { background:#e7f1ff; border-color:#0d6efd !important; color:#084298; font-weight:600; box-shadow:0 0 0 2px rgba(13,110,253,.25); }
