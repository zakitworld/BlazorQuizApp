@page "/leaderboard"
@using BlazorQuizApp.Models
@using BlazorQuizApp.Services
@inject IQuizBusinessService QuizBusinessService
@inject INotificationService NotificationService

<PageTitle>Leaderboard | BlazorQuiz</PageTitle>
<div class="data-page-shell leaderboard-page">
    <header class="data-page-header"><div><span class="eyebrow">Community performance</span><h1>The leaderboard</h1><p>Celebrate consistency, accuracy, and the learners setting the pace.</p></div><button class="btn btn-outline-secondary" @onclick="LoadLeaderboard"><i class="bi bi-arrow-clockwise me-2"></i>Refresh</button></header>
    <nav class="filter-rail" aria-label="Leaderboard category">
        <button class="@(selectedCategory==null?"active":"")" @onclick="() => FilterBy(null)">All topics</button>
        @foreach(var category in categories){<button class="@(selectedCategory==category?"active":"")" @onclick="() => FilterBy(category)">@category</button>}
    </nav>
    <LoadingSpinner IsLoading="@isLoading" Message="Ranking top performers..." />
    @if(!isLoading && leaderboard.Any())
    {
        <section class="podium-grid">
            @foreach(var entry in leaderboard.Take(3).Select((result,index)=>new{result,rank=index+1}))
            {
                <article class="podium-card rank-@entry.rank"><div class="podium-rank">@GetRankIcon(entry.rank)</div><div class="avatar-token">@Initials(entry.result.UserName)</div><span class="podium-place">#@entry.rank</span><h2>@DisplayName(entry.result.UserName)</h2><strong>@entry.result.ScorePercentage.ToString("F0")%</strong><small>@entry.result.CorrectAnswers/@entry.result.TotalQuestions correct · @entry.result.Score pts</small></article>
            }
        </section>
        <section class="ranking-surface">
            <div class="ranking-head"><span>Rank</span><span>Learner</span><span>Topic</span><span>Accuracy</span><span>Points</span></div>
            @foreach(var entry in leaderboard.Skip(3).Select((result,index)=>new{result,rank=index+4}))
            {
                <div class="ranking-row"><strong>#@entry.rank</strong><div class="learner-cell"><div class="avatar-token small">@Initials(entry.result.UserName)</div><span><b>@DisplayName(entry.result.UserName)</b><small>@entry.result.CompletedAt.ToString("MMM d, yyyy") · @entry.result.Duration.ToString(@"mm\:ss")</small></span></div><span class="status-pill">@(string.IsNullOrWhiteSpace(entry.result.Category)?"Mixed":entry.result.Category)</span><div class="accuracy-cell"><span>@entry.result.ScorePercentage.ToString("F0")%</span><i><b style="width:@entry.result.ScorePercentage%"></b></i></div><strong>@entry.result.Score</strong></div>
            }
        </section>
    }
    else if(!isLoading){<div class="empty-state"><i class="bi bi-trophy"></i><h3>The first place is waiting</h3><p>Complete a scored quiz to become the first learner on this board.</p><a class="btn btn-primary" href="/quiz">Take a quiz</a></div>}
</div>

@code {
    private List<QuizResult> leaderboard=[];private List<string> categories=[];private string? selectedCategory;private bool isLoading=true;
    protected override async Task OnInitializedAsync()=>await LoadLeaderboard();
    private async Task FilterBy(string? category){selectedCategory=category;await LoadLeaderboard();}
    private async Task LoadLeaderboard(){try{isLoading=true;leaderboard=await QuizBusinessService.GetLeaderboardAsync(15,selectedCategory);if(!categories.Any()){var all=await QuizBusinessService.GetLeaderboardAsync(200);categories=all.Select(r=>r.Category).Where(c=>!string.IsNullOrEmpty(c)).Distinct().OrderBy(c=>c).ToList();}}catch(Exception ex){NotificationService.ShowError($"Failed to load leaderboard: {ex.Message}");}finally{isLoading=false;}}
    private static string GetRankIcon(int rank)=>rank switch{1=>"🥇",2=>"🥈",3=>"🥉",_=>rank.ToString()};
    private static string DisplayName(string? name)=>string.IsNullOrWhiteSpace(name)?"Anonymous learner":name;
    private static string Initials(string? name){if(string.IsNullOrWhiteSpace(name))return "AL";var local=name.Split('@')[0];var words=local.Split(new[]{'.','_',' ','-'},StringSplitOptions.RemoveEmptyEntries);return string.Concat(words.Take(2).Select(w=>char.ToUpperInvariant(w[0])));}
}
