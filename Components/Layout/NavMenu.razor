@implements IDisposable
@inject NavigationManager NavigationManager
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using BlazorQuizApp.Models

<nav class="navbar navbar-expand-md shadow-sm fixed-top app-navbar @(ShouldBeTransparent ? "navbar-light navbar-surface" : "navbar-dark bg-dark")">
    <div class="container-fluid px-3 px-lg-5">

        <a class="navbar-brand fw-bold fs-5" href="/">
            <i class="bi bi-patch-question-fill text-primary"></i>BlazorQuiz
        </a>

        <button class="navbar-toggler border-0" type="button"
                data-bs-toggle="collapse" data-bs-target="#mainNav"
                aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="mainNav">

            <ul class="navbar-nav me-auto mt-2 mt-md-0">
                <li class="nav-item">
                    <NavLink class="nav-link px-3" href="" Match="NavLinkMatch.All">
                        <i class="bi bi-house-door"></i>Home
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link px-3" href="quiz">
                        <i class="bi bi-play-circle"></i>Take Quiz
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link px-3" href="leaderboard">
                        <i class="bi bi-trophy"></i>Leaderboard
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link px-3" href="pricing">
                        <i class="bi bi-star"></i>Pricing
                    </NavLink>
                </li>
                <AuthorizeView>
                    <Authorized>
                        <li class="nav-item"><NavLink class="nav-link px-3" href="assignments"><i class="bi bi-journal-check"></i>Assignments</NavLink></li>
                    </Authorized>
                </AuthorizeView>
                <AuthorizeView>
                    <Authorized>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle px-3" href="#" id="dashboardDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-speedometer2"></i>Dashboard
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark shadow border-0" aria-labelledby="dashboardDropdown">
                                <li>
                                    <NavLink class="dropdown-item py-2" href="/quiz-history">
                                        <i class="bi bi-clock-history me-2"></i>History
                                    </NavLink>
                                </li>
                                <li>
                                    <NavLink class="dropdown-item py-2" href="/statistics">
                                        <i class="bi bi-graph-up me-2"></i>Statistics
                                    </NavLink>
                                </li>
                                <AuthorizeView Roles="Admin" Context="adminContext">
                                    <Authorized>
                                        <li><hr class="dropdown-divider bg-secondary"></li>
                                        <li>
                                            <NavLink class="dropdown-item py-2 text-info" href="/instructor">
                                                <i class="bi bi-mortarboard me-2"></i>Instructor Workspace
                                            </NavLink>
                                        </li>
                                        <li>
                                            <NavLink class="dropdown-item py-2 text-info" href="/admin">
                                                <i class="bi bi-shield-lock me-2"></i>Administration
                                            </NavLink>
                                        </li>
                                        <li>
                                            <NavLink class="dropdown-item py-2 text-info" href="/manage-questions">
                                                <i class="bi bi-gear me-2"></i>Manage Questions
                                            </NavLink>
                                        </li>
                                    </Authorized>
                                </AuthorizeView>
                            </ul>
                        </li>
                    </Authorized>
                </AuthorizeView>
            </ul>

            <ul class="navbar-nav ms-auto mt-2 mt-md-0 align-items-md-center">
                <AuthorizeView>
                    <Authorized>
                        <li class="nav-item dropdown ms-md-2">
                            <a class="nav-link dropdown-toggle px-3" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle"></i>
                                <span class="d-none d-lg-inline">@context.User.Identity?.Name</span>
                                <span class="d-lg-none">Account</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark shadow border-0" aria-labelledby="userDropdown">
                                <li>
                                    <NavLink class="dropdown-item py-2" href="/Account/Manage">
                                        <i class="bi bi-person-gear me-2"></i>Settings
                                    </NavLink>
                                </li>
                                <li><hr class="dropdown-divider bg-secondary"></li>
                                <li>
                                    <form action="Account/Logout" method="post">
                                        <AntiforgeryToken />
                                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                                        <button type="submit" class="dropdown-item py-2 text-danger w-100 text-start">
                                            <i class="bi bi-box-arrow-right me-2"></i>Logout
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    </Authorized>
                    <NotAuthorized>
                        <li class="nav-item">
                            <NavLink class="nav-link px-3" href="/Account/Register">
                                <i class="bi bi-person-plus"></i>Register
                            </NavLink>
                        </li>
                        <li class="nav-item ms-md-1">
                            <a class="btn btn-primary btn-sm px-3 py-2" href="/Account/Login">
                                <i class="bi bi-box-arrow-in-right"></i>Login
                            </a>
                        </li>
                    </NotAuthorized>
                </AuthorizeView>
            </ul>

        </div>
    </div>
</nav>

@code {
    private string? currentUrl;

    private bool ShouldBeTransparent => 
        string.IsNullOrEmpty(currentUrl) || 
        currentUrl == "leaderboard" || 
        currentUrl == "pricing" || 
        currentUrl == "statistics" || 
        currentUrl == "quiz-history" || 
        currentUrl == "manage-questions" ||
        currentUrl.StartsWith("Account/Login") ||
        currentUrl.StartsWith("Account/Register");

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }


    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
