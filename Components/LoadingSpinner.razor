@if (IsLoading)
{
    <div class="loading-spinner @Size">
        <div class="spinner-border @SpinnerColor" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        @if (!string.IsNullOrEmpty(Message))
        {
            <div class="loading-message mt-2">
                <small class="text-muted">@Message</small>
            </div>
        }
    </div>
}

@code {
    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public string Message { get; set; } = string.Empty;

    [Parameter]
    public string Size { get; set; } = "spinner-border-sm";

    [Parameter]
    public string SpinnerColor { get; set; } = "text-primary";
} 