@page "/quiz"
@using BlazorQuizApp.Models
@using BlazorQuizApp.Services
@using BlazorQuizApp.Configuration
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Options
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using System.Security.Claims
@inject IQuizBusinessService QuizBusinessService
@inject ISubscriptionService SubscriptionService
@inject INotificationService NotificationService
@inject NavigationManager NavigationManager
@inject IOptions<AppSettings> AppSettings
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<Quiz> Logger
@inject IJSRuntime JS
@attribute [Authorize]
@implements IDisposable

<LoadingSpinner IsLoading="@isLoading" Message="@loadingMessage" />

@if (!isLoading)
{
    @* ── Subscription limit ── *@
    @if (!canTakeQuiz)
    {
        <div class="alert alert-warning">
            <h4 class="alert-heading"><i class="bi bi-exclamation-triangle me-2"></i>Quiz Limit Reached</h4>
            <p>You've reached your monthly limit of @monthlyLimit quizzes (@monthlyCount taken this month).</p>
            <hr>
            <a href="/pricing" class="btn btn-primary mt-2"><i class="bi bi-star me-1"></i>Upgrade to Premium</a>
        </div>
    }

    @* ── Topic selector ── *@
    else if (string.IsNullOrEmpty(Category))
    {
        <div class="topic-selector">
            <div class="text-center mb-4">
                <h1 class="fw-bold">Choose a Topic</h1>
                <p class="text-muted lead">Select a subject then choose your mode.</p>
            </div>

            @* Mode toggle *@
            <div class="d-flex justify-content-center flex-wrap gap-2 mb-4">
                <button class="btn @(quizMode == QuizMode.Timed ? "btn-primary shadow-sm" : "btn-outline-secondary") px-3"
                        @onclick="() => SetMode(QuizMode.Timed)">
                    <i class="bi bi-stopwatch me-1"></i>Timed Quiz
                </button>
                <button class="btn @(quizMode == QuizMode.Practice ? "btn-success shadow-sm" : "btn-outline-secondary") px-3"
                        @onclick="() => SetMode(QuizMode.Practice)">
                    <i class="bi bi-book me-1"></i>Practice Mode
                </button>
                <button class="btn @(quizMode == QuizMode.ExamSimulation ? "btn-dark shadow-sm" : "btn-outline-secondary") px-3"
                        @onclick="() => SetMode(QuizMode.ExamSimulation)">
                    <i class="bi bi-mortarboard-fill me-1"></i>CBT Mock Exam
                </button>
            </div>

            @if (quizMode == QuizMode.Practice)
            {
                <div class="alert alert-success text-center py-2 mb-4">
                    <i class="bi bi-info-circle me-1"></i>
                    Practice mode: untimed, instant explanations, pure learning!
                </div>
            }
            else if (quizMode == QuizMode.ExamSimulation)
            {
                <div class="alert alert-dark text-center py-2 mb-4">
                    <i class="bi bi-mortarboard me-1"></i>
                    CBT Mock Exam: full exam conditions, navigate freely, flag questions for review, no spoilers until submission with official grade report!
                </div>
            }

            @if (!availableCategories.Any())
            {
                <div class="alert alert-info text-center">
                    No questions added yet.
                    <a href="/manage-questions" class="btn btn-primary ms-2">Add Questions</a>
                </div>
            }
            else
            {
                <div class="d-flex justify-content-center flex-wrap gap-2 mb-4">
                    <button class="btn btn-sm @(activeSectionFilter == "All" ? "btn-dark shadow-sm" : "btn-outline-secondary") rounded-pill px-3 py-1"
                            @onclick='() => activeSectionFilter = "All"'>
                        All Topics (@availableCategories.Count)
                    </button>
                    <button class="btn btn-sm @(activeSectionFilter == QuizCategorySections.TechAndCyber ? "btn-dark shadow-sm" : "btn-outline-secondary") rounded-pill px-3 py-1"
                            @onclick='() => activeSectionFilter = QuizCategorySections.TechAndCyber'>
                        💻 Tech & Cyber
                    </button>
                    <button class="btn btn-sm @(activeSectionFilter == QuizCategorySections.NationalExams ? "btn-dark shadow-sm" : "btn-outline-secondary") rounded-pill px-3 py-1"
                            @onclick='() => activeSectionFilter = QuizCategorySections.NationalExams'>
                        🎓 National Exams (WAEC)
                    </button>
                    <button class="btn btn-sm @(activeSectionFilter == QuizCategorySections.ProfessionalLicensure ? "btn-dark shadow-sm" : "btn-outline-secondary") rounded-pill px-3 py-1"
                            @onclick='() => activeSectionFilter = QuizCategorySections.ProfessionalLicensure'>
                        👨‍🏫 Teacher & Licensure
                    </button>
                </div>

                @if (!DisplayedCategories.Any())
                {
                    <div class="alert alert-light text-center border py-4 my-3">
                        <p class="text-muted mb-0">No topics found in this section yet.</p>
                    </div>
                }
                else
                {
                    <div class="row g-3 justify-content-center">
                        @foreach (var cat in DisplayedCategories)
                        {
                            var bestScore = bestScoresPerCategory.GetValueOrDefault(cat.Key, -1);
                            var sectionName = QuizCategorySections.GetSection(cat.Key);
                            <div class="col-6 col-md-4 col-lg-3">
                                <button class="topic-card w-100 h-100 p-3 text-center border-0 position-relative"
                                        @onclick="() => StartQuiz(cat.Key)">
                                    <div class="topic-icon mb-2">@GetCategoryIcon(cat.Key)</div>
                                    <div class="fw-semibold">@cat.Key</div>
                                    <div class="text-muted small mb-1">@cat.Value q@(cat.Value != 1 ? "s" : "")</div>
                                    <span class="badge @QuizCategorySections.GetSectionBadgeClass(sectionName) text-opacity-75" style="font-size: 0.68rem;">
                                        @sectionName
                                    </span>
                                    @if (bestScore >= 0)
                                    {
                                        <div class="mt-2">
                                            <span class="badge @GetScoreBadgeClass(bestScore)">
                                                Best: @bestScore.ToString("F0")%
                                            </span>
                                        </div>
                                    }
                                </button>
                            </div>
                        }
                    </div>
                }
            }
        </div>
    }

    @* ── Active quiz ── *@
    else if (questions.Any() && !isQuizCompleted)
    {
        <div class="quiz-page" @ref="quizContainer" tabindex="0" @onkeydown="HandleKeyDown"
             style="outline:none;">

            @* Header bar *@
            <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
                <button class="btn btn-sm btn-outline-secondary" @onclick="ConfirmBackToTopics">
                    <i class="bi bi-arrow-left me-1"></i>Topics
                </button>
                <h2 class="mb-0 fw-bold me-auto">
                    @Category @(isExamMode ? "CBT Mock Exam" : "Quiz")
                    @if (quizMode == QuizMode.Practice)
                    {
                        <span class="badge bg-success ms-2 fs-6">Practice</span>
                    }
                    else if (isExamMode)
                    {
                        <span class="badge bg-dark ms-2 fs-6"><i class="bi bi-mortarboard me-1"></i>Exam Mode</span>
                    }
                </h2>
                @if (isExamMode && currentQuestion != null)
                {
                    <button class="btn btn-sm @(flaggedQuestionIds.Contains(currentQuestion.Id) ? "btn-warning" : "btn-outline-warning")"
                            @onclick="() => ToggleFlag(currentQuestion.Id)">
                        <i class="bi @(flaggedQuestionIds.Contains(currentQuestion.Id) ? "bi-flag-fill" : "bi-flag") me-1"></i>
                        @(flaggedQuestionIds.Contains(currentQuestion.Id) ? "Flagged" : "Flag Question")
                    </button>
                    <button class="btn btn-sm btn-danger ms-1" @onclick="() => showSubmitConfirm = true">
                        <i class="bi bi-send-check me-1"></i>Finish & Submit
                    </button>
                }
                @if (streak >= 3 && !isExamMode)
                {
                    <span class="badge bg-warning text-dark fs-6">
                        🔥 @streak streak!
                    </span>
                }
                @if (!practiceMode && !isExamMode)
                {
                    <span class="badge bg-primary fs-6">
                        <i class="bi bi-star-fill me-1"></i>@currentScore pts
                    </span>
                    <button class="btn btn-sm @(isPaused ? "btn-success" : "btn-outline-secondary")"
                            @onclick="TogglePause">
                        <i class="bi @(isPaused ? "bi-play-fill" : "bi-pause-fill")"></i>
                        @(isPaused ? "Resume" : "Pause")
                    </button>
                }
            </div>

            @* Pause overlay *@
            @if (isPaused)
            {
                <div class="pause-overlay text-center p-5">
                    <i class="bi bi-pause-circle text-primary" style="font-size:4rem;"></i>
                    <h3 class="mt-3">Quiz Paused</h3>
                    <p class="text-muted">Your timer is stopped. Press Resume when you're ready.</p>
                    <button class="btn btn-primary btn-lg" @onclick="TogglePause">
                        <i class="bi bi-play-fill me-2"></i>Resume Quiz
                    </button>
                </div>
            }
            else
            {
                @* Progress *@
                <div class="quiz-header mb-4">
                    <div class="row align-items-center g-2">
                        <div class="col-12 col-lg-7">
                            <div class="progress mb-1" style="height:8px;">
                                <div class="progress-bar bg-success"
                                     style="width:@(GetProgressPercentage().ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%">
                                </div>
                            </div>
                            <small class="text-muted">
                                Question @(currentQuestionIndex + 1) of @questions.Count @(isExamMode ? $"({AnsweredCount} answered, {flaggedQuestionIds.Count} flagged)" : "")
                            </small>
                        </div>
                        <div class="col-12 col-lg-5 text-lg-end text-center">
                            @if (!practiceMode)
                            {
                                <QuizTimer @ref="quizTimer"
                                           DurationSeconds="@currentQuestionDuration"
                                           OnTimeUp="HandleTimeUp"
                                           OnTimeChanged="HandleTimeChanged" />
                            }
                        </div>
                    </div>

                    @if (questions.Count > 1)
                    {
                        <div class="d-flex flex-wrap gap-1 justify-content-center mt-3">
                            @for (int i = 0; i < questions.Count; i++)
                            {
                                var idx = i;
                                var qId = questions[idx].Id;
                                var answered = userAnswers.Any(a => a.QuestionId == qId && a.SelectedOptionId != -1);
                                var flagged = flaggedQuestionIds.Contains(qId);
                                var navClass = GetNavButtonClass(idx, answered, flagged, idx == currentQuestionIndex);
                                <button class="btn btn-sm @navClass"
                                        @onclick="() => NavigateToQuestion(idx)"
                                        title="@(flagged ? $"Question {idx + 1} (Flagged)" : $"Question {idx + 1}")">
                                    @(idx + 1)@(flagged ? "🚩" : "")
                                </button>
                            }
                        </div>
                    }
                </div>

                @* Question card *@
                @if (currentQuestion != null)
                {
                    <div class="question-card card shadow-sm">
                        <div class="card-body p-4">
                            <div class="d-flex gap-2 mb-3">
                                <span class="badge bg-primary">@currentQuestion.Category</span>
                                <span class="badge @GetDifficultyBadgeClass(currentQuestion.Difficulty)">
                                    @currentQuestion.Difficulty
                                </span>
                                @if (!practiceMode)
                                {
                                    <span class="badge bg-secondary ms-auto">
                                        +@AppSettings.Value.Quiz.GetPointsForDifficulty(currentQuestion.Difficulty) pts
                                    </span>
                                }
                            </div>
                            <h3 class="card-title mb-4 fs-5">@currentQuestion.QuestionText</h3>
                            <div class="options">
                                @for (int i = 0; i < currentQuestion.Options.Count; i++)
                                {
                                    var option = currentQuestion.Options[i];
                                    var letter = char.ConvertFromUtf32(65 + i);
                                    <button class="btn w-100 mb-2 p-3 text-start option-btn @GetOptionClass(option)"
                                            @onclick="() => SelectOption(option)"
                                            disabled="@(!isExamMode && isAnswered)"
                                            style="border-radius:8px; border:2px solid; transition:all .2s;">
                                        <span class="fw-bold me-2">@letter.</span>@option.Text
                                    </button>
                                }
                            </div>
                        </div>
                    </div>

                    @if (isExamMode)
                    {
                        <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
                            <button class="btn btn-outline-secondary" disabled="@(currentQuestionIndex == 0)" @onclick="PreviousQuestion">
                                <i class="bi bi-arrow-left me-1"></i>Previous
                            </button>
                            <div class="text-muted small">
                                Answered: @AnsweredCount of @questions.Count | Flagged: @flaggedQuestionIds.Count
                            </div>
                            <div class="d-flex gap-2">
                                @if (currentQuestionIndex < questions.Count - 1)
                                {
                                    <button class="btn btn-primary" @onclick="NextQuestion">
                                        Next <i class="bi bi-arrow-right ms-1"></i>
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-danger" @onclick="() => showSubmitConfirm = true">
                                        <i class="bi bi-send-check me-1"></i>Finish & Submit
                                    </button>
                                }
                            </div>
                        </div>
                    }

                    @* Feedback + explanation *@
                    @if (!isExamMode && isAnswered)
                    {
                        <div class="feedback-section mt-3">
                            @if (isCurrentAnswerCorrect)
                            {
                                <div class="alert alert-success d-flex align-items-center gap-2">
                                    <i class="bi bi-check-circle-fill fs-5"></i>
                                    <div>
                                        <strong>Correct!</strong>
                                        @if (!practiceMode && lastSpeedBonus > 0)
                                        {
                                            <span class="ms-2 badge bg-warning text-dark">
                                                ⚡ Speed bonus +@lastSpeedBonus pt!
                                            </span>
                                        }
                                        @if (streak >= 2)
                                        {
                                            <span class="ms-2">🔥 @streak in a row!</span>
                                        }
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-danger">
                                    <i class="bi bi-x-circle-fill me-2"></i>
                                    Incorrect. Correct answer: <strong>@GetCorrectAnswerText()</strong>
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(currentQuestion.Explanation))
                            {
                                <div class="alert alert-info">
                                    <i class="bi bi-lightbulb-fill me-2"></i>
                                    <strong>Explanation:</strong> @currentQuestion.Explanation
                                </div>
                            }

                            <div class="d-flex gap-2 flex-wrap mt-2">
                                @if (currentQuestionIndex > 0)
                                {
                                    <button class="btn btn-outline-secondary" @onclick="PreviousQuestion">
                                        <i class="bi bi-arrow-left me-1"></i>Previous
                                    </button>
                                }
                                <button class="btn btn-primary" @onclick="NextQuestion">
                                    @(currentQuestionIndex < questions.Count - 1 ? "Next Question" : "Finish Quiz")
                                    <i class="bi bi-arrow-right ms-1"></i>
                                </button>
                            </div>
                        </div>
                    }
                    else if (!isExamMode && currentQuestionIndex > 0)
                    {
                        <div class="mt-3">
                            <button class="btn btn-outline-secondary" @onclick="PreviousQuestion">
                                <i class="bi bi-arrow-left me-1"></i>Previous
                            </button>
                        </div>
                    }
                }
            }
        </div>
    }

    @* ── Results + Review ── *@
    else if (isQuizCompleted && quizResult != null)
    {
        <div class="results-container">
            <div class="card mb-4">
                <div class="card-header @(quizResult.ScorePercentage >= 60 ? "bg-success" : "bg-warning") text-white">
                    <h2 class="mb-0"><i class="bi bi-trophy-fill me-2"></i>Quiz Completed!</h2>
                </div>
                <div class="card-body text-center">
                    <div class="row g-3 mb-4 justify-content-center">
                        <div class="col-6 col-md-3">
                            <div class="stat-box p-3">
                                <div class="display-6 fw-bold text-primary">@quizResult.ScorePercentage.ToString("F0")%</div>
                                <div class="text-muted small">Score</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="stat-box p-3">
                                <div class="display-6 fw-bold text-success">@quizResult.CorrectAnswers/@quizResult.TotalQuestions</div>
                                <div class="text-muted small">Correct</div>
                            </div>
                        </div>
                        @if (!practiceMode)
                        {
                            <div class="col-6 col-md-3">
                                <div class="stat-box p-3">
                                    <div class="display-6 fw-bold text-warning">@quizResult.Score</div>
                                    <div class="text-muted small">Points</div>
                                </div>
                            </div>
                        }
                        <div class="col-6 col-md-3">
                            <div class="stat-box p-3">
                                <div class="display-6 fw-bold text-info">@quizResult.Duration.ToString(@"mm\:ss")</div>
                                <div class="text-muted small">Time</div>
                            </div>
                        </div>
                        @if (bestStreak >= 2)
                        {
                            <div class="col-6 col-md-3">
                                <div class="stat-box p-3">
                                    <div class="display-6 fw-bold text-danger">🔥 @bestStreak</div>
                                    <div class="text-muted small">Best Streak</div>
                                </div>
                            </div>
                        }
                    </div>

                    @if (quizResult.ScorePercentage >= 80)
                    {
                        <div class="alert alert-success"><i class="bi bi-star-fill me-2"></i>Excellent! Outstanding performance!</div>
                    }
                    else if (quizResult.ScorePercentage >= 60)
                    {
                        <div class="alert alert-warning"><i class="bi bi-emoji-smile me-2"></i>Good effort! Keep it up!</div>
                    }
                    else
                    {
                        <div class="alert alert-info"><i class="bi bi-lightbulb me-2"></i>Keep studying and try again!</div>
                    }

                    @* Stanine / National Exam Grade Card *@
                    @if (IsNationalExamCategory || isExamMode)
                    {
                        var stanine = GetStanineGrade(quizResult.ScorePercentage);
                        <div class="card mb-3 border-0 bg-light p-3 text-center">
                            <span class="text-muted small text-uppercase fw-semibold">Official Exam Evaluation</span>
                            <div class="d-flex align-items-center justify-content-center gap-3 my-2 flex-wrap">
                                <span class="badge @stanine.BadgeClass fs-5 px-3 py-2">@stanine.Grade</span>
                                <span class="fs-5 fw-bold text-dark">@stanine.Description</span>
                            </div>
                            @if (Category == "NTC Licensure Exams" || Category == "TEACHERS PROMOTION")
                            {
                                var licStatus = GetLicensureStatus(quizResult.ScorePercentage);
                                <div class="mt-1">
                                    <span class="badge @licStatus.BadgeClass px-3 py-1">@licStatus.Status</span>
                                </div>
                            }
                        </div>
                    }

                    <div class="d-flex flex-wrap gap-2 justify-content-center">
                        @if (MissedQuestionsCount > 0)
                        {
                            <button class="btn btn-danger shadow-sm px-3" @onclick="PracticeMissedQuestions">
                                <i class="bi bi-bullseye me-1"></i>Practice Missed Questions (@MissedQuestionsCount)
                            </button>
                        }
                        <button class="btn btn-primary" @onclick="RestartQuiz">
                            <i class="bi bi-arrow-clockwise me-1"></i>Retry Topic
                        </button>
                        <button class="btn btn-outline-primary" @onclick="BackToTopics">
                            <i class="bi bi-grid me-1"></i>Choose Topic
                        </button>
                        @if (!practiceMode)
                        {
                            <a href="/leaderboard" class="btn btn-warning">
                                <i class="bi bi-trophy me-1"></i>Leaderboard
                            </a>
                        }
                        <a href="/" class="btn btn-secondary"><i class="bi bi-house me-1"></i>Home</a>
                    </div>
                </div>
            </div>

            @* ── Review screen ── *@
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-list-check me-2"></i>Review All Questions</h5>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => showReview = !showReview">
                        @(showReview ? "Hide" : "Show") Review
                    </button>
                </div>
                @if (showReview)
                {
                    <div class="card-body p-0">
                        @for (int i = 0; i < questions.Count; i++)
                        {
                            var q = questions[i];
                            var answer = quizResult.Answers.FirstOrDefault(a => a.QuestionId == q.Id);
                            var userOptionId = answer?.SelectedOptionId ?? -1;
                            var isCorrect = userOptionId == q.CorrectOptionId;
                            var qNum = i + 1;
                            <div class="review-item p-4 border-bottom">
                                <div class="d-flex align-items-start gap-2 mb-2">
                                    <span class="badge @(isCorrect ? "bg-success" : "bg-danger") mt-1">@qNum</span>
                                    <div class="flex-grow-1">
                                        <div class="d-flex gap-1 mb-2">
                                            <span class="badge bg-primary">@q.Category</span>
                                            <span class="badge @GetDifficultyBadgeClass(q.Difficulty)">@q.Difficulty</span>
                                        </div>
                                        <p class="mb-2 fw-semibold">@q.QuestionText</p>
                                        <div class="options-review">
                                            @foreach (var opt in q.Options)
                                            {
                                                var isUserChoice = opt.Id == userOptionId;
                                                var isRight = opt.Id == q.CorrectOptionId;
                                                var cls = isRight ? "border-success text-success bg-success bg-opacity-10"
                                                        : isUserChoice ? "border-danger text-danger bg-danger bg-opacity-10"
                                                        : "border-secondary text-muted";
                                                <div class="d-flex align-items-center gap-2 p-2 mb-1 rounded border @cls">
                                                    @if (isRight)
                                                    {
                                                        <i class="bi bi-check-circle-fill text-success"></i>
                                                    }
                                                    else if (isUserChoice)
                                                    {
                                                        <i class="bi bi-x-circle-fill text-danger"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-circle text-muted"></i>
                                                    }
                                                    <span>@opt.Text</span>
                                                    @if (isUserChoice && !isRight)
                                                    {
                                                        <span class="ms-auto badge bg-danger">Your answer</span>
                                                    }
                                                    @if (isRight)
                                                    {
                                                        <span class="ms-auto badge bg-success">Correct</span>
                                                    }
                                                </div>
                                            }
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(q.Explanation))
                                        {
                                            <div class="mt-2 p-2 rounded bg-info bg-opacity-10 border border-info">
                                                <i class="bi bi-lightbulb-fill text-info me-1"></i>
                                                <small>@q.Explanation</small>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }

    @* ── No questions ── *@
    else if (!isLoading && !questions.Any() && !string.IsNullOrEmpty(Category))
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>
            No questions for <strong>@Category</strong> yet.
        </div>
        <div class="d-flex gap-2 mt-2">
            <button class="btn btn-outline-primary" @onclick="BackToTopics">
                <i class="bi bi-grid me-1"></i>Choose Another Topic
            </button>
            <a href="/manage-questions" class="btn btn-primary">
                <i class="bi bi-plus-circle me-1"></i>Add Questions
            </a>
        </div>
    }

    @if (showSubmitConfirm)
    {
        <div class="modal fade show d-block" style="background: rgba(0,0,0,0.55);" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow-lg">
                    <div class="modal-header bg-dark text-white">
                        <h5 class="modal-title"><i class="bi bi-mortarboard-fill me-2"></i>Submit Exam Confirmation</h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="() => showSubmitConfirm = false"></button>
                    </div>
                    <div class="modal-body text-center p-4">
                        <p class="lead mb-3">Are you ready to submit your exam?</p>
                        <div class="d-flex justify-content-center gap-3 mb-3">
                            <div class="p-2 border rounded bg-light text-center" style="min-width: 90px;">
                                <div class="h4 mb-0 text-success">@AnsweredCount</div>
                                <small class="text-muted">Answered</small>
                            </div>
                            <div class="p-2 border rounded bg-light text-center" style="min-width: 90px;">
                                <div class="h4 mb-0 text-secondary">@(questions.Count - AnsweredCount)</div>
                                <small class="text-muted">Unanswered</small>
                            </div>
                            <div class="p-2 border rounded bg-light text-center" style="min-width: 90px;">
                                <div class="h4 mb-0 text-warning">@flaggedQuestionIds.Count</div>
                                <small class="text-muted">Flagged</small>
                            </div>
                        </div>
                        @if (questions.Count - AnsweredCount > 0)
                        {
                            <div class="alert alert-warning py-2 small">
                                <i class="bi bi-exclamation-triangle me-1"></i>You still have unanswered questions!
                            </div>
                        }
                    </div>
                    <div class="modal-footer justify-content-center">
                        <button type="button" class="btn btn-outline-secondary" @onclick="() => showSubmitConfirm = false">
                            Continue Reviewing
                        </button>
                        <button type="button" class="btn btn-danger" @onclick="ConfirmAndSubmitExam">
                            Yes, Submit Exam Now
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
}

<style>
    .topic-card { background:#fff; border-radius:16px; border:2px solid rgba(13,110,253,.12) !important; color:#333; cursor:pointer; transition:all .2s; }
    .topic-card:hover { border-color:#0d6efd !important; transform:translateY(-4px); box-shadow:0 8px 24px rgba(13,110,253,.15); color:#0d6efd; }
    .topic-icon { font-size:2rem; }
    .pause-overlay { background:rgba(255,255,255,.97); border-radius:16px; border:2px dashed #0d6efd; }
