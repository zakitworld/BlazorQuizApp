{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Error"
    }
  },
  "AllowedHosts": "*",
  "AppSettings": {
    "Quiz": {
      "DefaultTimeLimit": 300,
      "MaxQuestionsPerQuiz": 10,
      "RandomizeQuestions": true
    },
    "BaseUrl": "https://quizapp.example.com"
  },
  "EmailSettings": {
    "FromEmail": "noreply@quizapp.example.com",
    "FromName": "Quiz App"
  },
  "Paystack": {
    "CallbackUrl": "https://quizapp.example.com/subscription/verify",
    "PricingPlans": {
      "PremiumMonthly": "",
      "ProMonthly": ""
    }
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 60
      },
      {
        "Endpoint": "*/quiz",
        "Period": "1h",
        "Limit": 20
      }
    ]
  }
}
